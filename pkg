#!/usr/bin/env sh
VERSION=1.0.0
APPS=${PKG_APPS:-/Applications}
RECEIPTS=${PKG_RECEIPTS:-/Library/Receipts}
SYSDB=${PKG_SYSDB:-/var/lib/pacman/local}
SYNC=${PKG_SYNC:-/var/lib/pacman/sync}
CACHE=${PKG_CACHE:-/var/cache/pacman/pkg}
GPG=${PKG_GPG:-/etc/pacman.d/gnupg}

if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

OWNER=${PKG_OWNER:-${SUDO_UID:-0}:${SUDO_GID:-0}}
NEW=""
PACMAN=${PKG_PACMAN:-/usr/lib/fasdeqos/pacman}
if [ ! -x "$PACMAN" ]; then
    PACMAN=pacman
fi

die() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

usage() {
    cat <<USAGE
Usage: pkg <command> [arguments]

  install <package> ...    Install applications into /Applications
  uninstall <package> ...  Remove applications (aliases: remove, rm)
  list [--removed]         List installed applications
  search <text>            Search available packages
  info <package>           Show package details
  update                   Refresh package databases
  upgrade [package ...]    Upgrade installed applications
  cleanup                  Forget removed applications and clear caches
  --version                Show version
USAGE
}

bundle_name() {
    case $1 in
        vlc) echo VLC ;;
        gimp) echo GIMP ;;
        libreoffice-fresh) echo LibreOffice ;;
        telegram-desktop) echo Telegram ;;
        nautilus) echo Files ;;
        gnome-console) echo Console ;;
        gnome-text-editor) echo TextEditor ;;
        *)
            first=$(printf '%s' "$1" | cut -c1 | tr a-z A-Z)
            rest=$(printf '%s' "$1" | cut -c2-)
            echo "$first$rest" ;;
    esac
}

pacman_in() {
    b=$1
    shift
    "$PACMAN" -r "$b" --dbpath "$b/.db" --cachedir "$CACHE" --gpgdir "$GPG" --logfile /var/log/pkg.log --noscriptlet --noconfirm "$@"
}

refresh_db() {
    rm -rf "$1/.db/local"
    mkdir -p "$1/.db"
    cp -R "$SYSDB" "$1/.db/local"
    if [ -d "$1/.db/own" ]; then
        cp -R "$1/.db/own/." "$1/.db/local/"
    fi
}

field() {
    sed -n "s/^$2=//p" "$1"
}

set_state() {
    sed "s/^state=.*/state=$2/" "$1" > "$1.tmp" && mv "$1.tmp" "$1"
}

scan_receipts() {
    for r in "$RECEIPTS"/*.receipt; do
        [ -f "$r" ] || continue
        name=$(basename "$r" .receipt)
        if [ "$(field "$r" state)" = installed ] && [ ! -d "$APPS/$name.pkg" ]; then
            set_state "$r" removed
        fi
    done
}

refresh_union() {
    if [ -n "${PKG_NO_UNION:-}" ] || [ -z "$NEW" ]; then
        return 0
    fi
    for b in $NEW; do
        mount -t overlay overlay -o "lowerdir=/usr:$b/usr" /usr 2>/dev/null || true
    done
    ldconfig 2>/dev/null || true
}

fix_shebangs() {
    grep -rIl '^#!/bin/' "$1" 2>/dev/null | while IFS= read -r f; do
        first=$(head -n1 "$f")
        case $first in
            "#!/bin/sh"|"#!/bin/sh "*|"#!/bin/bash"|"#!/bin/bash "*)
                rest=$(printf '%s\n' "$first" | cut -c8-)
                case $rest in
                    *" "*) pre='#!/usr/bin/env -S ' ;;
                    *) pre='#!/usr/bin/env ' ;;
                esac
                { printf '%s%s\n' "$pre" "$rest"; tail -n +2 "$f"; } > "$f.fix"
                cat "$f.fix" > "$f"
                rm -f "$f.fix" ;;
        esac
    done
}

install_one() {
    p=$1
    name=$(bundle_name "$p")
    b="$APPS/$name.pkg"
    if [ -d "$b" ]; then
        printf '%s is already installed.\n' "$name"
        return 0
    fi
    if "$PACMAN" --dbpath "$(dirname "$SYSDB")" -Qq "$p" >/dev/null 2>&1; then
        printf '%s is part of the system.\n' "$p"
        return 0
    fi
    ls "$SYNC"/*.db >/dev/null 2>&1 || die "Package databases are missing. Run: pkg update"
    printf '==> Installing %s\n' "$name"
    mkdir -p "$b/.db/sync" "$b/.db/own"
    refresh_db "$b"
    cp "$SYNC"/* "$b/.db/sync/"
    if ! pacman_in "$b" -Si "$p" >/dev/null 2>&1; then
        rm -rf "$b"
        die "No available package named '$p'."
    fi
    before=$(mktemp /tmp/pkg.XXXXXX)
    after=$(mktemp /tmp/pkg.XXXXXX)
    ls "$b/.db/local" | sort > "$before"
    if ! pacman_in "$b" --needed -S "$p"; then
        rm -rf "$b" "$before" "$after"
        die "Could not install '$p'."
    fi
    ls "$b/.db/local" | sort > "$after"
    names=""
    for d in $(comm -13 "$before" "$after"); do
        cp -R "$b/.db/local/$d" "$b/.db/own/$d"
        n=$(sed -n '2p' "$b/.db/own/$d/desc")
        names="$names $n"
    done
    rm -f "$before" "$after"
    rm -rf "$b/.db/sync"
    if [ ! -d "$b/usr" ]; then
        rm -rf "$b"
        die "'$p' has no application files to install."
    fi
    mkdir -p "$RECEIPTS"
    printf 'bundle=%s\nrequested=%s\npackages=%s\nstate=installed\n' "$name" "$p" "$names" > "$RECEIPTS/$name.receipt"
    fix_shebangs "$b/usr"
    chown -R "$OWNER" "$b"
    NEW="$NEW $b"
    printf '==> Installed %s to %s\n' "$name" "$b"
    case $p in
        steam|steam-native-runtime|wine*|lutris)
            printf 'Note: %s needs /bin. Add fasdeqos_bin=1 to the kernel command line.\n' "$name" ;;
    esac
}

cmd_install() {
    [ $# -gt 0 ] || die "Usage: pkg install <package> ..."
    for p in "$@"; do
        install_one "$p"
    done
    refresh_union
}

cmd_uninstall() {
    [ $# -gt 0 ] || die "Usage: pkg uninstall <package> ..."
    for p in "$@"; do
        name=$(bundle_name "$p")
        if [ -d "$APPS/$name.pkg" ]; then
            rm -rf "$APPS/$name.pkg"
            printf '==> Uninstalled %s\n' "$name"
        else
            printf '%s is not installed.\n' "$name"
        fi
        rm -f "$RECEIPTS/$name.receipt"
    done
}

cmd_list() {
    want=installed
    if [ "${1:-}" = "--removed" ]; then
        want=removed
    fi
    scan_receipts
    for r in "$RECEIPTS"/*.receipt; do
        [ -f "$r" ] || continue
        if [ "$(field "$r" state)" = "$want" ]; then
            basename "$r" .receipt
        fi
    done
}

cmd_search() {
    [ $# -gt 0 ] || die "Usage: pkg search <text>"
    "$PACMAN" -Ss "$@"
}

cmd_info() {
    [ $# -gt 0 ] || die "Usage: pkg info <package>"
    "$PACMAN" -Si "$1" || exit 1
    name=$(bundle_name "$1")
    r="$RECEIPTS/$name.receipt"
    if [ -f "$r" ]; then
        printf 'Status          : %s (%s/%s.pkg)\n' "$(field "$r" state)" "$APPS" "$name"
    else
        printf 'Status          : not installed\n'
    fi
}

cmd_update() {
    "$PACMAN" -Sy
}

upgrade_one() {
    r=$1
    name=$(basename "$r" .receipt)
    b="$APPS/$name.pkg"
    if [ ! -d "$b" ]; then
        set_state "$r" removed
        printf 'Skipping %s (removed by you)\n' "$name"
        return 0
    fi
    if [ "$(field "$r" state)" != installed ]; then
        return 0
    fi
    printf '==> Upgrading %s\n' "$name"
    refresh_db "$b"
    mkdir -p "$b/.db/sync"
    cp "$SYNC"/* "$b/.db/sync/"
    pkgs=$(field "$r" packages)
    pacman_in "$b" --needed -S $pkgs
    rm -rf "$b/.db/sync"
    chown -R "$OWNER" "$b"
}

cmd_upgrade() {
    if [ $# -gt 0 ]; then
        for p in "$@"; do
            r="$RECEIPTS/$(bundle_name "$p").receipt"
            if [ -f "$r" ]; then
                upgrade_one "$r"
            else
                printf '%s is not installed.\n' "$p"
            fi
        done
        return 0
    fi
    for r in "$RECEIPTS"/*.receipt; do
        [ -f "$r" ] || continue
        upgrade_one "$r"
    done
}

cmd_cleanup() {
    scan_receipts
    for r in "$RECEIPTS"/*.receipt; do
        [ -f "$r" ] || continue
        if [ "$(field "$r" state)" = removed ]; then
            rm -f "$r"
        fi
    done
    "$PACMAN" -Sc --noconfirm
}

cmd=${1:-help}
if [ $# -gt 0 ]; then
    shift
fi

case $cmd in
    install) cmd_install "$@" ;;
    uninstall|remove|rm) cmd_uninstall "$@" ;;
    list|ls) cmd_list "$@" ;;
    search) cmd_search "$@" ;;
    info) cmd_info "$@" ;;
    update) cmd_update ;;
    upgrade) cmd_upgrade "$@" ;;
    cleanup) cmd_cleanup ;;
    --version|-v|version) echo "pkg $VERSION" ;;
    *) usage ;;
esac
