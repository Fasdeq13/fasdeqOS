#!/bin/sh
set -eu

VERSION=2026.10.10-11
HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=./darwin/rootfs
OUT=./darwin/fasdeqos-live.iso
LIVEUSER=fasdeqos
PASSWORD=fasdeqos
BUSYBOX_URL=https://busybox.net/downloads/binaries/1.35.0-x86_64-linux-musl/busybox
MIRRORS="https://geo.mirror.pkgbuild.com https://mirrors.kernel.org/archlinux https://mirror.rackspace.com/archlinux"
KMODS_BASE="loop squashfs overlay isofs sr_mod cdrom sd_mod ahci libahci nvme usb_storage uas xhci_pci ehci_pci ohci_pci uhci_hcd virtio_blk virtio_pci virtio_scsi ata_piix ata_generic nls_utf8 nls_cp437"
REBUILD=0
FIRMWARE=1
NVIDIA=1
GPU=1
BROADCOM=1
STACK_PKGS="distrobox podman crun conmon netavark aardvark-dns fuse-overlayfs slirp4netns shadow flatpak bubblewrap xdg-dbus-proxy curl libarchive git"
GPU_PKGS="mesa vulkan-icd-loader vulkan-radeon vulkan-intel libdrm nvidia-utils"
FW_PKGS="linux-firmware-whence linux-firmware-amdgpu linux-firmware-atheros linux-firmware-broadcom linux-firmware-cirrus linux-firmware-intel linux-firmware-mediatek linux-firmware-nvidia linux-firmware-other linux-firmware-radeon linux-firmware-realtek"
TOOL_PKGS="kmod xz zstd zlib-ng-compat openssl"

say() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

while [ $# -gt 0 ]; do
    case $1 in
        --root) ROOT=$2; shift ;;
        --out) OUT=$2; shift ;;
        --rebuild) REBUILD=1 ;;
        --no-firmware) FIRMWARE=0 ;;
        --no-nvidia) NVIDIA=0 ;;
        --no-gpu-userspace) GPU=0 ;;
        --lean) FIRMWARE=0; NVIDIA=0; GPU=0; BROADCOM=0 ;;
        -h|--help)
            printf 'usage: build-iso [--root DIR] [--out FILE.iso] [--rebuild] [--lean] [--no-firmware] [--no-nvidia] [--no-gpu-userspace]\n'
            exit 0 ;;
        *) die "unknown option: $1" ;;
    esac
    shift
done

[ "$(id -u)" -eq 0 ] || die "run as root"
miss=""
for t in curl bsdtar zstd gzip openssl mksquashfs cc grub-mkrescue xorriso mformat modprobe depmod ldconfig mount find; do
    command -v "$t" >/dev/null 2>&1 || miss="$miss $t"
done
[ -z "$miss" ] || die "missing tools:$miss"

WORK=$(mktemp -d /tmp/fasdeqos-iso.XXXXXX)
trap 'rm -rf "$WORK"' EXIT

ensure_rootfs() {
    if [ "$REBUILD" -eq 1 ] || [ ! -d "$ROOT/System" ] || [ ! -f "$ROOT/Library/.layout" ]; then
        say "Building the rootfs"
        sh "$HERE/build-rootfs" --root "$ROOT"
    fi
}

arch_pkg() {
    local p=$1 repo=${2:-core} m idx f pat
    pat=$(printf '%s' "$p" | sed 's/+/\\(+\\|%2B\\)/g')
    for m in $MIRRORS; do
        idx=$(curl -fsL -m 60 "$m/$repo/os/x86_64/" 2>/dev/null || true)
        [ -n "$idx" ] || continue
        f=$(printf '%s\n' "$idx" | grep -o "href=\"$pat-[0-9][^\"]*-x86_64.pkg.tar.zst\"" | sed 's/^href="//;s/"$//' | sort -V | tail -n 1)
        [ -n "$f" ] || continue
        curl -fsL -m 1800 -o "$WORK/$f" "$m/$repo/os/x86_64/$f" || continue
        printf '%s' "$WORK/$f"
        return 0
    done
    return 1
}

add_kernel() {
    local pkg
    say "Downloading the Arch kernel"
    pkg=$(arch_pkg linux) || die "the kernel package could not be downloaded"
    rm -rf "$WORK/k"
    mkdir -p "$WORK/k"
    bsdtar -xpf "$pkg" -C "$WORK/k" --exclude ./.PKGINFO --exclude ./.MTREE --exclude ./.BUILDINFO --exclude ./.INSTALL
    KVER=$(ls "$WORK/k/usr/lib/modules" | head -n 1)
    [ -n "$KVER" ] || die "the kernel package has no modules"
    say "Kernel $KVER"
    rm -rf "$ROOT/System/lib/modules/$KVER"
    mkdir -p "$ROOT/System/lib/modules"
    cp -a "$WORK/k/usr/lib/modules/$KVER" "$ROOT/System/lib/modules/$KVER"
    cp "$WORK/k/usr/lib/modules/$KVER/vmlinuz" "$WORK/vmlinuz"
}

install_tree() {
    local src=$1 r=$2
    mkdir -p "$r/System/lib/glibc"
    if [ -d "$src/usr/lib" ]; then
        find "$src/usr/lib" -maxdepth 1 \( -type f -o -type l \) -name '*.so*' -exec cp -af {} "$r/System/lib/glibc/" \; -exec rm -f {} \;
    fi
    if [ -d "$src/usr" ]; then
        cp -an "$src/usr/." "$r/System/"
    fi
    if [ -d "$src/etc" ]; then
        cp -an "$src/etc/." "$r/private/etc/"
    fi
}

add_arch_pkgs() {
    local repo=$1 list=$2 p pkg
    for p in $list; do
        pkg=$(arch_pkg "$p" "$repo") || { say "warning: $p was not found, skipping"; continue; }
        rm -rf "$WORK/ap"
        mkdir -p "$WORK/ap"
        bsdtar -xpf "$pkg" -C "$WORK/ap" --exclude ./.PKGINFO --exclude ./.MTREE --exclude ./.BUILDINFO --exclude ./.INSTALL
        install_tree "$WORK/ap" "$ROOT"
    done
}

add_kmod_pkg() {
    local name=$1 pkg
    pkg=$(arch_pkg "$name" extra) || { say "warning: $name could not be downloaded, skipping"; return 0; }
    rm -rf "$WORK/km"
    mkdir -p "$WORK/km"
    bsdtar -xpf "$pkg" -C "$WORK/km" --exclude ./.PKGINFO --exclude ./.MTREE --exclude ./.BUILDINFO --exclude ./.INSTALL
    if [ ! -d "$WORK/km/usr/lib/modules/$KVER" ]; then
        say "warning: $name is built for $(ls "$WORK/km/usr/lib/modules" 2>/dev/null | head -n 1), not for $KVER, skipping"
        return 0
    fi
    cp -a "$WORK/km/usr/lib/modules/." "$ROOT/System/lib/modules/"
}

add_hw_support() {
    say "Adding kmod and the tools it needs"
    add_arch_pkgs core "$TOOL_PKGS"
    if [ "$FIRMWARE" -eq 1 ]; then
        say "Adding firmware for real hardware, this is large"
        add_arch_pkgs core "$FW_PKGS"
    fi
    if [ "$NVIDIA" -eq 1 ]; then
        say "Adding the NVIDIA open kernel modules"
        add_kmod_pkg nvidia-open
    fi
    if [ "$BROADCOM" -eq 1 ]; then
        say "Adding the Broadcom wireless module"
        add_kmod_pkg broadcom-wl
    fi
    say "Indexing the kernel modules"
    depmod -b "$ROOT/System" "$KVER" || die "depmod failed"
}

add_glibc_ldconfig() {
    local pkg
    pkg=$(arch_pkg glibc core) || die "glibc could not be downloaded for ldconfig"
    rm -rf "$WORK/gl"
    mkdir -p "$WORK/gl"
    bsdtar -xpf "$pkg" -C "$WORK/gl" usr/bin/ldconfig
    mkdir -p "$ROOT/System/lib/fasdeqos/bin"
    cp "$WORK/gl/usr/bin/ldconfig" "$ROOT/System/lib/fasdeqos/bin/ldconfig"
    chmod 755 "$ROOT/System/lib/fasdeqos/bin/ldconfig"
}

arch_stack() {
    local list=$1
    ARCH_FETCH_CACHE="$HERE/cache/arch-fetch" sh "$HERE/arch-fetch" --quiet --root "$ROOT" $list || die "arch-fetch failed for: $list"
}

add_pkg_stack() {
    say "Installing distrobox, podman, flatpak and their dependencies"
    mkdir -p "$ROOT/private/var/lib" "$HERE/cache/arch-fetch"
    arch_stack "$STACK_PKGS"
    for f in newuidmap newgidmap; do
        [ -e "$ROOT/System/bin/$f" ] && chmod 4755 "$ROOT/System/bin/$f"
    done
    for f in distrobox podman flatpak curl; do
        [ -e "$ROOT/System/bin/$f" ] || say "warning: $f is missing after the install"
    done
    if [ "$GPU" -eq 1 ]; then
        say "Installing the Mesa and NVIDIA userspace, this is large"
        arch_stack "$GPU_PKGS"
    fi
    mkdir -p "$ROOT/private/etc/ssl/certs"
    rm -f "$ROOT/private/etc/ssl/certs/ca-certificates.crt" "$ROOT/private/etc/ssl/cert.pem"
    if [ -f /etc/ssl/certs/ca-certificates.crt ]; then
        cp /etc/ssl/certs/ca-certificates.crt "$ROOT/private/etc/ssl/certs/ca-certificates.crt"
        cp /etc/ssl/certs/ca-certificates.crt "$ROOT/private/etc/ssl/cert.pem"
    else
        say "warning: the host has no CA bundle, HTTPS inside the image will fail"
    fi
    cp "$HERE/arch-fetch" "$ROOT/System/bin/arch-fetch"
    chmod 755 "$ROOT/System/bin/arch-fetch"
}

build_pkg() {
    [ -f "$HERE/pkg.c" ] || die "pkg.c is missing next to this script"
    say "Building pkg"
    cc -static -O2 -o "$ROOT/System/bin/pkg" "$HERE/pkg.c" || die "pkg failed to build"
    mkdir -p "$ROOT/System/share/fish/vendor_completions.d" "$ROOT/System/share/applications" "$ROOT/Applications" "$ROOT/Library/pkg/db"
    "$ROOT/System/bin/pkg" completions > "$ROOT/System/share/fish/vendor_completions.d/pkg.fish"
}

write_containers_conf() {
    local h=$ROOT/Users/$LIVEUSER
    mkdir -p "$h/.config/containers"
    cat > "$h/.config/containers/storage.conf" <<'STORE'
[storage]
driver = "overlay"
[storage.options.overlay]
mount_program = "/System/bin/fuse-overlayfs"
STORE
    printf '%s:100000:65536\n' "$LIVEUSER" > "$ROOT/private/etc/subuid"
    printf '%s:100000:65536\n' "$LIVEUSER" > "$ROOT/private/etc/subgid"
    chown -R 1000:1000 "$h"
}

build_ld_cache() {
    local t=$WORK/ldroot
    say "Building the glibc library cache"
    mkdir -p "$t/System/lib/glibc" "$t/etc"
    mount --bind "$ROOT/System/lib/glibc" "$t/System/lib/glibc" || die "bind mount for the library cache failed"
    printf '/System/lib/glibc\n' > "$t/etc/ld.so.conf"
    if ! ldconfig -r "$t"; then
        umount "$t/System/lib/glibc" || true
        die "ldconfig failed"
    fi
    umount "$t/System/lib/glibc" || die "umount failed"
    cp "$t/etc/ld.so.cache" "$ROOT/private/etc/ld.so.cache"
    printf '/System/lib/glibc\n' > "$ROOT/private/etc/ld.so.conf"
}

add_busybox() {
    say "Downloading a static busybox"
    curl -fsL -m 300 -o "$WORK/busybox" "$BUSYBOX_URL" || die "busybox could not be downloaded"
    chmod +x "$WORK/busybox"
    cp "$WORK/busybox" "$ROOT/System/bin/busybox"
    if [ ! -e "$ROOT/System/bin/sh" ]; then
        ln -s busybox "$ROOT/System/bin/sh"
    fi
}

build_launchd() {
    [ -f "$HERE/fasd-launchd.c" ] || die "fasd-launchd.c is missing next to this script"
    say "Building fasd-launchd"
    cc -static -O2 -o "$ROOT/System/bin/fasd-launchd" "$HERE/fasd-launchd.c" || die "fasd-launchd failed to build, install gcc and libc6-dev"
    rm -f "$ROOT/System/bin/init"
    ln -s fasd-launchd "$ROOT/System/bin/init"
}

add_gcc_libs() {
    say "Refreshing the gcc runtime libraries"
    add_arch_pkgs core "libgcc libstdc++"
    [ -e "$ROOT/System/lib/glibc/libgcc_s.so.1" ] || die "libgcc_s.so.1 is missing after the copy"
    [ -e "$ROOT/System/lib/glibc/libstdc++.so.6" ] || die "libstdc++.so.6 is missing after the copy"
    printf '/System/lib/glibc\n' > "$ROOT/private/etc/ld.so.conf"
}

