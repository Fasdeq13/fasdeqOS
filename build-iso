busybox chmod 700 /run/user/1000
busybox find /sys/devices -name modalias -type f 2>/dev/null | busybox xargs busybox cat 2>/dev/null | busybox xargs /System/bin/modprobe -a -b -q 2>/dev/null
for m in fuse tun overlay veth bridge br_netfilter nf_tables nft_masq nft_nat nft_chain_nat nf_nat xt_MASQUERADE xt_conntrack xt_addrtype nf_conntrack; do
    /System/bin/modprobe -q "$m" 2>/dev/null
done
echo 'fasdeqOS live system'
RC
    cat > "$ROOT/System/bin/fasdeqos-session" <<'SES'
#!/System/bin/busybox sh
export PATH=/System/lib/fasdeqos/bin:/System/bin:/bin
export TERM=linux
export TERMINFO=/System/share/terminfo
export HOME=/Users/fasdeqos USER=fasdeqos LOGNAME=fasdeqos SHELL=/System/bin/bash
export XDG_RUNTIME_DIR=/run/user/1000
export XDG_DATA_DIRS=/System/share:/home/linuxbrew/.linuxbrew/share
cd "$HOME"
exec busybox su -m -c 'exec /System/bin/bash -l' fasdeqos
SES
    cat > "$d/ls" <<'LS'
#!/System/bin/busybox sh
REAL=/System/bin/ls
target=""
count=0
skip=0
for a in "$@"; do
    case $a in
        --*) ;;
        -*) case $a in *[aAdR]*) skip=1 ;; esac ;;
        *) count=$((count + 1)); target=$a ;;
    esac
done
if [ "$count" -gt 1 ]; then
    skip=1
fi
if [ -z "$target" ]; then
    target=.
fi
if [ "$skip" -eq 1 ] || [ ! -d "$target" ] || [ ! -f "$target/.hidden" ]; then
    exec "$REAL" "$@"
fi
hidden=$(cat "$target/.hidden")
n=$#
i=0
removed=0
while [ "$i" -lt "$n" ]; do
    a=$1
    shift
    if [ "$a" = "$target" ] && [ "$removed" -eq 0 ] && [ "$target" != . ]; then
        removed=1
    else
        set -- "$@" "$a"
    fi
    i=$((i + 1))
done
cd "$target" || exit 1
set -- "$@" --
found=0
for e in *; do
    if [ ! -e "$e" ] && [ ! -L "$e" ]; then
        continue
    fi
    h=0
    for x in $hidden; do
        if [ "$x" = "$e" ]; then
            h=1
        fi
    done
    if [ "$h" -eq 0 ]; then
        set -- "$@" "$e"
        found=1
    fi
done
if [ "$found" -eq 0 ]; then
    exit 0
fi
exec "$REAL" -d "$@"
LS
    chmod +x "$ROOT/System/bin/fasdeqos-rc" "$ROOT/System/bin/fasdeqos-session" "$d/ls"
}

collect_modules() {
    local m line f i=0 name kd=$ROOT/System/lib/modules/$KVER/kernel/drivers sub
    KMODS=$KMODS_BASE
    for sub in ata nvme scsi usb/host usb/storage mmc/host block virtio hv; do
        if [ -d "$kd/$sub" ]; then
            KMODS="$KMODS $(find "$kd/$sub" -name '*.ko*' | sed 's#.*/##; s#\.ko.*##' | tr '\n' ' ')"
        fi
    done
    : > "$WORK/modlist.raw"
    for m in $KMODS; do
        modprobe -d "$ROOT/System" -S "$KVER" --show-depends "$m" 2>/dev/null | sed -n 's/^insmod //p' | awk '{print $1}' >> "$WORK/modlist.raw" || true
    done
    awk '!s[$0]++' "$WORK/modlist.raw" > "$WORK/modlist"
    mkdir -p "$WORK/initrd/m"
    : > "$WORK/initrd/modules.order"
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        i=$((i + 1))
        name=$(printf '%03d-%s' "$i" "$(basename "$f")")
        case $f in
            *.zst) name=${name%.zst}; zstd -dc "$f" > "$WORK/initrd/m/$name" ;;
            *.xz) name=${name%.xz}; xz -dc "$f" > "$WORK/initrd/m/$name" ;;
            *.gz) name=${name%.gz}; gzip -dc "$f" > "$WORK/initrd/m/$name" ;;
            *) cp "$f" "$WORK/initrd/m/$name" ;;
        esac
        printf '%s\n' "$name" >> "$WORK/initrd/modules.order"
    done < "$WORK/modlist"
    say "$i kernel modules go into the initramfs"
}

make_initramfs() {
    local d=$WORK/initrd
    mkdir -p "$d/bin" "$d/dev" "$d/proc" "$d/sys" "$d/iso" "$d/sfs" "$d/cow" "$d/newroot"
    cp "$WORK/busybox" "$d/bin/busybox"
    collect_modules
    cat > "$d/init" <<'INIT'
#!/bin/busybox sh
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
for f in $(cat /modules.order); do
    insmod /m/$f 2>/dev/null
done
found=""
n=0
while [ -z "$found" ] && [ "$n" -lt 60 ]; do
    for d in /dev/sr* /dev/sd* /dev/vd* /dev/nvme*n*; do
        [ -b "$d" ] || continue
        mount -t iso9660 -o ro "$d" /iso 2>/dev/null || continue
        if [ -f /iso/live/rootfs.sfs ]; then
            found=$d
            break
        fi
        umount /iso
    done
    if [ -z "$found" ]; then
        n=$((n + 1))
        sleep 1
    fi
done
if [ -z "$found" ]; then
    echo 'fasdeqOS: the live media was not found, dropping to a shell'
    exec sh
fi
mount -t squashfs -o loop,ro /iso/live/rootfs.sfs /sfs || { echo 'squashfs mount failed'; exec sh; }
mount -t tmpfs tmpfs /cow
mkdir -p /cow/up /cow/work
mount -t overlay overlay -o lowerdir=/sfs,upperdir=/cow/up,workdir=/cow/work /newroot || { echo 'overlay mount failed'; exec sh; }
mkdir -p /newroot/run/live/iso /newroot/run/live/sfs /newroot/run/live/cow
mount --move /iso /newroot/run/live/iso
mount --move /sfs /newroot/run/live/sfs
mount --move /cow /newroot/run/live/cow
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /dev /newroot/dev
exec switch_root /newroot /System/bin/init
INIT
    chmod +x "$d/init"
    (cd "$d" && bsdtar --format newc --uid 0 --gid 0 -cf - .) | gzip -9 > "$WORK/initramfs.img"
}

make_iso() {
    local iso=$WORK/iso
    mkdir -p "$iso/boot/grub" "$iso/live"
    cp "$WORK/vmlinuz" "$iso/boot/vmlinuz"
    cp "$WORK/initramfs.img" "$iso/boot/initramfs.img"
    say "Compressing the root file system, this takes a few minutes"
    mksquashfs "$ROOT" "$iso/live/rootfs.sfs" -comp zstd -noappend -quiet
    cat > "$iso/boot/grub/grub.cfg" <<'CFG'
set default=0
set timeout=5
menuentry "fasdeqOS Live" {
    linux /boot/vmlinuz init=/System/bin/fasd-launchd rw quiet console=tty0
    initrd /boot/initramfs.img
}
menuentry "fasdeqOS Live (safe graphics)" {
    linux /boot/vmlinuz init=/System/bin/fasd-launchd rw nomodeset console=tty0
    initrd /boot/initramfs.img
}
menuentry "fasdeqOS Live (verbose)" {
    linux /boot/vmlinuz init=/System/bin/fasd-launchd rw console=tty0
    initrd /boot/initramfs.img
}
CFG
    mkdir -p "$(dirname "$OUT")"
    say "Writing the ISO with GRUB"
    grub-mkrescue -o "$OUT" "$iso" -- -volid FASDEQOS_LIVE >"$WORK/grub.log" 2>&1 || { cat "$WORK/grub.log" >&2; die "grub-mkrescue failed"; }
}

say "fasdeqos iso builder $VERSION"
ensure_rootfs
add_kernel
add_hw_support
add_busybox
build_launchd
add_gcc_libs
add_fastfetch
add_glibc_ldconfig
add_pkg_stack
build_pkg
build_ld_cache
write_os_release
write_users
write_containers_conf
write_init
make_initramfs
make_iso
say "Ready: $OUT"
say "Login: $LIVEUSER / $PASSWORD, root password: $PASSWORD"
