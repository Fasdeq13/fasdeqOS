#!/bin/sh
set -eu

VERSION=2026.10.09-2
HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=./darwin/rootfs
OUT=./darwin/fasdeqos-live.iso
LIVEUSER=fasdeqos
PASSWORD=fasdeqos
BUSYBOX_URL=https://busybox.net/downloads/binaries/1.35.0-x86_64-linux-musl/busybox
MIRRORS="https://geo.mirror.pkgbuild.com https://mirrors.kernel.org/archlinux https://mirror.rackspace.com/archlinux"
KMODS="loop squashfs overlay isofs sr_mod cdrom sd_mod ahci libahci nvme usb_storage uas xhci_pci ehci_pci ohci_pci uhci_hcd virtio_blk virtio_pci virtio_scsi ata_piix ata_generic nls_utf8 nls_cp437"
REBUILD=0

say() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

while [ $# -gt 0 ]; do
    case $1 in
        --root) ROOT=$2; shift ;;
        --out) OUT=$2; shift ;;
        --rebuild) REBUILD=1 ;;
        -h|--help)
            printf 'usage: build-iso [--root DIR] [--out FILE.iso] [--rebuild]\n'
            exit 0 ;;
        *) die "unknown option: $1" ;;
    esac
    shift
done

[ "$(id -u)" -eq 0 ] || die "run as root"
miss=""
for t in curl bsdtar zstd gzip openssl mksquashfs grub-mkrescue xorriso modprobe depmod find; do
    command -v "$t" >/dev/null 2>&1 || miss="$miss $t"
done
[ -z "$miss" ] || die "missing tools:$miss"

WORK=$(mktemp -d /tmp/fasdeqos-iso.XXXXXX)
trap 'rm -rf "$WORK"' EXIT

ensure_rootfs() {
    if [ "$REBUILD" -eq 1 ] || [ ! -d "$ROOT/System" ]; then
        say "Building the rootfs"
        sh "$HERE/build-rootfs" --root "$ROOT"
    fi
}

arch_pkg() {
    local p=$1 m idx f
    for m in $MIRRORS; do
        idx=$(curl -fsL -m 60 "$m/core/os/x86_64/" 2>/dev/null || true)
        [ -n "$idx" ] || continue
        f=$(printf '%s\n' "$idx" | grep -o "href=\"$p-[0-9][^\"]*-x86_64.pkg.tar.zst\"" | sed 's/^href="//;s/"$//' | sort -V | tail -n 1)
        [ -n "$f" ] || continue
        curl -fsL -m 1800 -o "$WORK/$f" "$m/core/os/x86_64/$f" || continue
        printf '%s' "$WORK/$f"
        return 0
    done
    return 1
}

add_kernel() {
    local pkg
    say "Downloading the Arch kernel"
    pkg=$(arch_pkg linux) || die "the kernel package could not be downloaded"
    rm -rf "$WORK/k"
    mkdir -p "$WORK/k"
    bsdtar -xpf "$pkg" -C "$WORK/k" --exclude ./.PKGINFO --exclude ./.MTREE --exclude ./.BUILDINFO --exclude ./.INSTALL
    KVER=$(ls "$WORK/k/usr/lib/modules" | head -n 1)
    [ -n "$KVER" ] || die "the kernel package has no modules"
    say "Kernel $KVER"
    rm -rf "$ROOT/System/lib/modules/$KVER"
    mkdir -p "$ROOT/System/lib/modules"
    cp -a "$WORK/k/usr/lib/modules/$KVER" "$ROOT/System/lib/modules/$KVER"
    cp "$WORK/k/usr/lib/modules/$KVER/vmlinuz" "$WORK/vmlinuz"
    depmod -b "$ROOT/System" "$KVER" || die "depmod failed"
}

add_busybox() {
    say "Downloading a static busybox"
    curl -fsL -m 300 -o "$WORK/busybox" "$BUSYBOX_URL" || die "busybox could not be downloaded"
    chmod +x "$WORK/busybox"
    cp "$WORK/busybox" "$ROOT/System/bin/busybox"
    if [ ! -e "$ROOT/System/bin/sh" ]; then
        ln -s busybox "$ROOT/System/bin/sh"
    fi
    rm -f "$ROOT/System/bin/init"
    ln -s busybox "$ROOT/System/bin/init"
}

write_os_release() {
    cat > "$ROOT/System/lib/os-release" <<'OSREL'
NAME="fasdeqOS"
PRETTY_NAME="fasdeqOS"
ID=fasdeqos
ID_LIKE=fasdeq
BUILD_ID=rolling
ANSI_COLOR="38;2;23;147;209"
HOME_URL="https://fasdeq13.github.io/fasdeq-os/"
DOCUMENTATION_URL="https://fasdeq13.github.io/fasdeq-os/#overview"
SUPPORT_URL="https://fasdeq13.github.io/fasdeq-os/"
BUG_REPORT_URL="https://github.com/Fasdeq13/fasdeqOS/pulls"
LOGO=fasdeqos-logo
OSREL
    rm -f "$ROOT/private/etc/os-release"
    ln -s ../System/lib/os-release "$ROOT/private/etc/os-release"
}

write_users() {
    local h f
    for f in passwd group shadow shells profile inittab hostname; do
        rm -f "$ROOT/private/etc/$f"
    done
    h=$(openssl passwd -6 "$PASSWORD")
    printf 'root:x:0:0:root:/root:/System/bin/sh\n%s:x:1000:1000:%s:/Users/%s:/System/bin/sh\nnobody:x:65534:65534:nobody:/:/System/bin/false\n' "$LIVEUSER" "$LIVEUSER" "$LIVEUSER" > "$ROOT/private/etc/passwd"
    printf 'root:x:0:\nwheel:x:10:%s\nusers:x:100:\n%s:x:1000:\nnobody:x:65534:\n' "$LIVEUSER" "$LIVEUSER" > "$ROOT/private/etc/group"
    printf 'root:%s:19000:0:99999:7:::\n%s:%s:19000:0:99999:7:::\nnobody:!:19000:::::::\n' "$h" "$LIVEUSER" "$h" > "$ROOT/private/etc/shadow"
    chmod 600 "$ROOT/private/etc/shadow"
    printf '/System/bin/sh\n' > "$ROOT/private/etc/shells"
    mkdir -p "$ROOT/Users/$LIVEUSER"
    chown -R 1000:1000 "$ROOT/Users/$LIVEUSER"
    if [ -d "$ROOT/Library/Homebrew" ]; then
        chown -R 1000:1000 "$ROOT/Library/Homebrew"
    fi
    cat > "$ROOT/private/etc/profile" <<'PROF'
export PATH=/System/bin:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin
export PS1='\u@\h \W % '
export HOME=${HOME:-/Users}
PROF
}

write_init() {
    cat > "$ROOT/private/etc/inittab" <<'TAB'
::sysinit:/System/bin/fasdeqos-rc
tty1::respawn:-/System/bin/fasdeqos-session
tty2::respawn:-/System/bin/busybox su -l root
::ctrlaltdel:/System/bin/busybox reboot
::shutdown:/System/bin/busybox umount -a -r
TAB
    cat > "$ROOT/System/bin/fasdeqos-rc" <<'RC'
#!/System/bin/busybox sh
export PATH=/System/bin:/bin
busybox mount -t devpts devpts /dev/pts 2>/dev/null || { busybox mkdir -p /dev/pts; busybox mount -t devpts devpts /dev/pts; }
busybox mkdir -p /dev/shm
busybox mount -t tmpfs tmpfs /dev/shm
busybox hostname fasdeqos
busybox ip link set lo up 2>/dev/null
busybox mkdir -p /run/user
echo 'fasdeqOS live system'
RC
    cat > "$ROOT/System/bin/fasdeqos-session" <<'SES'
#!/System/bin/busybox sh
export PATH=/System/bin:/bin
exec busybox su -l fasdeqos
SES
    chmod +x "$ROOT/System/bin/fasdeqos-rc" "$ROOT/System/bin/fasdeqos-session"
}

collect_modules() {
    local m line f i=0 name
    : > "$WORK/modlist.raw"
    for m in $KMODS; do
        modprobe -d "$ROOT/System" -S "$KVER" --show-depends "$m" 2>/dev/null | sed -n 's/^insmod //p' | awk '{print $1}' >> "$WORK/modlist.raw" || true
    done
    awk '!s[$0]++' "$WORK/modlist.raw" > "$WORK/modlist"
    mkdir -p "$WORK/initrd/m"
    : > "$WORK/initrd/modules.order"
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        i=$((i + 1))
        name=$(printf '%03d-%s' "$i" "$(basename "$f")")
        case $f in
            *.zst) name=${name%.zst}; zstd -dc "$f" > "$WORK/initrd/m/$name" ;;
            *.xz) name=${name%.xz}; xz -dc "$f" > "$WORK/initrd/m/$name" ;;
            *.gz) name=${name%.gz}; gzip -dc "$f" > "$WORK/initrd/m/$name" ;;
            *) cp "$f" "$WORK/initrd/m/$name" ;;
        esac
        printf '%s\n' "$name" >> "$WORK/initrd/modules.order"
    done < "$WORK/modlist"
    say "$i kernel modules go into the initramfs"
}

make_initramfs() {
    local d=$WORK/initrd
    mkdir -p "$d/bin" "$d/dev" "$d/proc" "$d/sys" "$d/iso" "$d/sfs" "$d/cow" "$d/newroot"
    cp "$WORK/busybox" "$d/bin/busybox"
    collect_modules
    cat > "$d/init" <<'INIT'
#!/bin/busybox sh
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
for f in $(cat /modules.order); do
    insmod /m/$f 2>/dev/null
done
found=""
n=0
while [ -z "$found" ] && [ "$n" -lt 60 ]; do
    for d in /dev/sr* /dev/sd* /dev/vd* /dev/nvme*n*; do
        [ -b "$d" ] || continue
        mount -t iso9660 -o ro "$d" /iso 2>/dev/null || continue
        if [ -f /iso/live/rootfs.sfs ]; then
            found=$d
            break
        fi
        umount /iso
    done
    if [ -z "$found" ]; then
        n=$((n + 1))
        sleep 1
    fi
done
if [ -z "$found" ]; then
    echo 'fasdeqOS: the live media was not found, dropping to a shell'
    exec sh
fi
mount -t squashfs -o loop,ro /iso/live/rootfs.sfs /sfs || { echo 'squashfs mount failed'; exec sh; }
mount -t tmpfs tmpfs /cow
mkdir -p /cow/up /cow/work
mount -t overlay overlay -o lowerdir=/sfs,upperdir=/cow/up,workdir=/cow/work /newroot || { echo 'overlay mount failed'; exec sh; }
mkdir -p /newroot/run/live/iso /newroot/run/live/sfs /newroot/run/live/cow
mount --move /iso /newroot/run/live/iso
mount --move /sfs /newroot/run/live/sfs
mount --move /cow /newroot/run/live/cow
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /dev /newroot/dev
exec switch_root /newroot /System/bin/init
INIT
    chmod +x "$d/init"
    (cd "$d" && bsdtar --format newc --uid 0 --gid 0 -cf - .) | gzip -9 > "$WORK/initramfs.img"
}

make_iso() {
    local iso=$WORK/iso
    mkdir -p "$iso/boot/grub" "$iso/live"
    cp "$WORK/vmlinuz" "$iso/boot/vmlinuz"
    cp "$WORK/initramfs.img" "$iso/boot/initramfs.img"
    say "Compressing the root file system, this takes a few minutes"
    mksquashfs "$ROOT" "$iso/live/rootfs.sfs" -comp zstd -noappend -quiet
    cat > "$iso/boot/grub/grub.cfg" <<'CFG'
set default=0
set timeout=5
menuentry "fasdeqOS Live" {
    linux /boot/vmlinuz init=/System/bin/init rw quiet console=tty0
    initrd /boot/initramfs.img
}
menuentry "fasdeqOS Live (safe graphics)" {
    linux /boot/vmlinuz init=/System/bin/init rw nomodeset console=tty0
    initrd /boot/initramfs.img
}
menuentry "fasdeqOS Live (verbose)" {
    linux /boot/vmlinuz init=/System/bin/init rw console=tty0
    initrd /boot/initramfs.img
}
CFG
    mkdir -p "$(dirname "$OUT")"
    say "Writing the ISO with GRUB"
    grub-mkrescue -o "$OUT" "$iso" -- -volid FASDEQOS_LIVE >"$WORK/grub.log" 2>&1 || { cat "$WORK/grub.log" >&2; die "grub-mkrescue failed"; }
}

say "fasdeqos iso builder $VERSION"
ensure_rootfs
add_kernel
add_busybox
write_os_release
write_users
write_init
make_initramfs
make_iso
say "Ready: $OUT"
say "Login: $LIVEUSER / $PASSWORD, root password: $PASSWORD"
