write_users() {
    local h f
    for f in passwd group shadow shells profile inittab hostname; do
        rm -f "$ROOT/private/etc/$f"
    done
    h=$(openssl passwd -6 "$PASSWORD")
    printf 'root:x:0:0:root:/root:/System/bin/bash\n%s:x:1000:1000:%s:/Users/%s:/System/bin/bash\nnobody:x:65534:65534:nobody:/:/System/bin/false\n' "$LIVEUSER" "$LIVEUSER" "$LIVEUSER" > "$ROOT/private/etc/passwd"
    printf 'root:x:0:\nwheel:x:10:%s\nusers:x:100:\n%s:x:1000:\nnobody:x:65534:\n' "$LIVEUSER" "$LIVEUSER" > "$ROOT/private/etc/group"
    printf 'root:%s:19000:0:99999:7:::\n%s:%s:19000:0:99999:7:::\nnobody:!:19000:::::::\n' "$h" "$LIVEUSER" "$h" > "$ROOT/private/etc/shadow"
    chmod 600 "$ROOT/private/etc/shadow"
    printf '/System/bin/bash\n/System/bin/sh\n' > "$ROOT/private/etc/shells"
    mkdir -p "$ROOT/Users/$LIVEUSER"
    chown -R 1000:1000 "$ROOT/Users/$LIVEUSER"
    if [ -d "$ROOT/Library/Homebrew" ]; then
        chown -R 1000:1000 "$ROOT/Library/Homebrew"
    fi
    chown -R 1000:1000 "$ROOT/Applications" "$ROOT/Library/pkg" "$ROOT/System/share/applications" 2>/dev/null || true
    cat > "$ROOT/private/etc/profile" <<'PROF'
export PATH=/System/lib/fasdeqos/bin:/System/bin:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin
export TERM=${TERM:-linux}
export TERMINFO=/System/share/terminfo
export PS1='\u@\h \w % '
export XDG_DATA_DIRS=/System/share:/home/linuxbrew/.linuxbrew/share
export XDG_RUNTIME_DIR=/run/user/$(id -u)
if [ -z "$FASD_SHOWN" ] && [ -t 1 ]; then
    FASD_SHOWN=1
    export FASD_SHOWN
    fastfetch 2>/dev/null
fi
export HOME=${HOME:-/Users}
PROF
}

