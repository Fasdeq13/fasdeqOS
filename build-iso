    mkdir -p "$d" "$ROOT/private/etc/dinit.d/boot.d"
    mkdir -p "$ROOT/private/var/log"
    printf 'type = internal\nwaits-for = homebrew-prefix\nwaits-for.d = boot.d\n' > "$ROOT/private/etc/dinit.d/boot"
    cat > "$ROOT/System/bin/fasdeqos-rc" <<'RC'
#!/System/bin/busybox sh
export PATH=/System/bin:/bin
busybox mkdir -p /dev/pts /dev/shm /run/user
busybox mount -t devpts devpts /dev/pts
busybox mount -t tmpfs tmpfs /dev/shm
busybox hostname fasdeqos
