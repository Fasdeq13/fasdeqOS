#!/bin/sh
set -eu

VERSION=2026.10.09-1
REPO=https://github.com/darlinghq/darling.git
BASE=/Library/Darling
SRC=$BASE/src
PREFIX=$BASE/root
LOG=/var/log/fasdeqos-darling.log
JOBS=$(nproc 2>/dev/null || echo 2)

say() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root"
say "fasdeqos darling installer $VERSION"

miss=""
for t in git git-lfs cmake make clang bison flex python3 pkg-config; do
    command -v "$t" >/dev/null 2>&1 || miss="$miss $t"
done
if [ -n "$miss" ]; then
    die "missing build tools:$miss. Install them first, for example with brew."
fi

KB=/lib/modules/$(uname -r)/build
[ -d "$KB" ] || die "kernel headers for $(uname -r) are not installed: $KB"

mkdir -p "$BASE"
if [ ! -d "$SRC/.git" ]; then
    say "Cloning Darling with submodules, this is several gigabytes"
    git clone --recursive "$REPO" "$SRC" >>"$LOG" 2>&1 || die "clone failed, see $LOG"
else
    say "Updating the Darling sources"
    git -C "$SRC" pull >>"$LOG" 2>&1 || true
    git -C "$SRC" submodule update --init --recursive >>"$LOG" 2>&1 || true
fi

mkdir -p "$SRC/build"
cd "$SRC/build"
say "Configuring"
cmake .. -DCMAKE_INSTALL_PREFIX="$PREFIX" -DCMAKE_BUILD_TYPE=Release >>"$LOG" 2>&1 || die "cmake failed, see $LOG"
say "Building the user space, this takes a long time"
make -j"$JOBS" >>"$LOG" 2>&1 || die "build failed, see $LOG"
make install >>"$LOG" 2>&1 || die "install failed, see $LOG"

say "Building the Mach kernel module"
make lkm >>"$LOG" 2>&1 || die "lkm build failed, see $LOG"
make lkm_install >>"$LOG" 2>&1 || die "lkm install failed, see $LOG"
depmod -a >/dev/null 2>&1 || true
modprobe darling-mach >>"$LOG" 2>&1 || say "darling-mach did not load, see $LOG"
printf 'darling-mach\n' > /private/etc/modules-load.d/darling.conf 2>/dev/null || true

for b in "$PREFIX"/bin/*; do
    [ -e "$b" ] || continue
    ln -sf "$b" "/System/bin/$(basename "$b")" 2>/dev/null || say "could not link $(basename "$b") into /System/bin, the system volume may be sealed"
done
say "Done. Try: darling shell"
