<section id="manual"><h2 data-t="t3"></h2><div data-t="b3"></div>
<pre><code>sgdisk --zap-all /dev/sdX
sgdisk -n1:0:+1M -t1:ef02 -n2:0:+512M -t2:ef00 -n3:0:0 -t3:8300 /dev/sdX
mkfs.fat -F32 -n EFI /dev/sdX2
mkfs.btrfs -L FasdeqOS /dev/sdX3
mount /dev/sdX3 /mnt
for v in root System Applications Library Users private; do btrfs subvolume create /mnt/$v; done
umount /mnt
mount -o compress=zstd:1,subvol=root /dev/sdX3 /mnt
mkdir -p /mnt/{System,Applications,Library,Users,private,Volumes,usr,lib,lib64,etc,var,tmp}
for v in System Applications Library Users private; do mount -o compress=zstd:1,subvol=$v /dev/sdX3 /mnt/$v; done
mkdir -p /mnt/private/stage/boot
mount /dev/sdX2 /mnt/private/stage/boot
pacstrap -K /mnt/private/stage filesystem glibc musl bash fish pacman util-linux kmod systemd linux linux-firmware mkinitcpio btrfs-progs grub efibootmgr sudo mesa</code></pre>
<div data-t="b3b"></div>
<pre><code>bsdtar -xpf fasdeqos-payload.tar.zst -C /mnt/private/stage
bsdtar -cpf - -C /mnt/private/stage/usr . | bsdtar -xpf - -C /mnt/System
rm -rf /mnt/private/stage/usr
mv /mnt/private/stage/etc /mnt/private/etc
mv /mnt/private/stage/var /mnt/private/var
mv /mnt/private/stage/root /mnt/private/var/root
rm -rf /mnt/private/stage</code></pre>
</section>
<section id="packages"><h2 data-t="t4"></h2><div data-t="b4"></div>
<pre><code># Install apps (heavy ones go into containers)
pkg install blender
pkg list
pkg upgrade

# Kernels, desktop environments, and userland
pkg kernel list
pkg kernel use linux-cachyos
pkg change-desktop gnome
pkg change-int busybox

# Repositories and system-level pacman
pkg add-repo https://repo.example.com custom
pkg sys -Syu
pkg cleanup</code></pre>
</section>
