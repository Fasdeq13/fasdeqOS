find_grub_cfg() {
    local c
    if [ ! -d /etc/grub.d ] || ! command -v grub-mkconfig >/dev/null; then
        return 1
    fi
    for c in /boot/grub/grub.cfg /boot/grub2/grub.cfg /efi/grub/grub.cfg /boot/efi/grub/grub.cfg; do
        if [ -f "$c" ]; then
            GRUB_CFG=$c
            return 0
        fi
    done
    return 1
}

find_limine_conf() {
    local c
    for c in "$ESP/limine.conf" "$ESP/EFI/limine/limine.conf" "$ESP/EFI/BOOT/limine.conf" /boot/limine/limine.conf /boot/limine.conf "$ESP/limine/limine.conf" "$ESP/limine.cfg" "$ESP/EFI/limine/limine.cfg" "$ESP/EFI/BOOT/limine.cfg" /boot/limine/limine.cfg /boot/limine.cfg; do
        if [ -f "$c" ]; then
            LIMINE_CONF=$c
            return 0
        fi
    done
    return 1
}

find_sdboot_root() {
    local d
    for d in "$ESP" /boot /efi /boot/efi; do
        if [ -f "$d/loader/loader.conf" ] && [ -e "$d/EFI/systemd/systemd-bootx64.efi" ]; then
            SDB_ROOT=$d
            return 0
        fi
    done
    return 1
}

find_windows() {
    local dev fs m tmp found
    while read -r dev fs; do
        if [ "$fs" != vfat ]; then
            continue
        fi
        m=$(findmnt -rno TARGET "$dev" 2>/dev/null | head -n1 || true)
        tmp=""
        if [ -z "$m" ]; then
            tmp=$(mktemp -d /tmp/fasdeqos-win.XXXXXX)
            if mount -o ro "$dev" "$tmp" 2>/dev/null; then
                m=$tmp
            else
                rmdir "$tmp"
                continue
            fi
        fi
        found=$(find "$m/EFI" -maxdepth 3 -iname bootmgfw.efi 2>/dev/null | head -n1 || true)
        if [ -n "$found" ]; then
            WIN_FILE=${found#"$m"}
            WIN_UUID=$(blkid -s UUID -o value "$dev")
            WIN_PARTUUID=$(blkid -s PARTUUID -o value "$dev")
            WINDOWS=1
        fi
        if [ -n "$tmp" ]; then
            umount "$tmp"
            rmdir "$tmp"
        fi
        if [ "$WINDOWS" -eq 1 ]; then
            return 0
        fi
    done < <(lsblk -rno PATH,FSTYPE)
    return 0
}

check_system() {
    [ "$(id -u)" -eq 0 ] || die "Run this script as root."
    command -v pacman >/dev/null || die "pacman is required."
    . /etc/os-release
    case ${ID:-} in
        arch|manjaro|cachyos|garuda|omarchy) ;;
        *) die "Supported systems: Arch, Manjaro, CachyOS and Garuda (Omarchy is experimental)." ;;
    esac
    if [ "${ID:-}" = omarchy ] || [ -d /usr/share/omarchy ] || compgen -G "/home/*/.local/share/omarchy" >/dev/null; then
        EXPERIMENTAL=1
    fi
    [ "$(findmnt -no FSTYPE /)" = btrfs ] || die "The root filesystem is not btrfs."
    DEV=$(findmnt -no SOURCE / | sed 's/\[.*//')
    case $DEV in
        /dev/mapper/*) die "Encrypted and LVM root filesystems are not supported." ;;
    esac
    [ ! -d /System ] || die "The FasdeqOS layout already exists."
    for t in /boot/efi /efi /boot; do
        if [ "$(findmnt -no FSTYPE "$t" 2>/dev/null || true)" = vfat ]; then
            ESP=$t
            break
        fi
    done
    [ -n "${ESP:-}" ] || die "The EFI system partition was not found. UEFI is required."
    ESP_DEV=$(findmnt -no SOURCE "$ESP")
    ESP_PARTUUID=$(blkid -s PARTUUID -o value "$ESP_DEV" || true)
    if find_grub_cfg; then
        LOADERS="$LOADERS grub"
    fi
    if find_limine_conf; then
        LOADERS="$LOADERS limine"
    fi
    if find_sdboot_root; then
        LOADERS="$LOADERS systemd-boot"
    fi
    [ -n "$LOADERS" ] || die "Supported boot loaders: GRUB, Limine and systemd-boot."
    find_windows
}

resolve_payload() {
    local c
    if [ -z "$PAYLOAD_SRC" ]; then
        for c in "$SELF_DIR/fasdeqos-payload.tar.zst" "$SELF_DIR/out/fasdeqos-payload.tar.zst" "$PWD/fasdeqos-payload.tar.zst"; do
            if [ -f "$c" ]; then
                PAYLOAD_SRC=$c
                break
            fi
        done
    fi
    case $PAYLOAD_SRC in
        http://*|https://*)
            PAYLOAD_URL=$PAYLOAD_SRC
            PAYLOAD_SRC="" ;;
    esac
    if [ -n "$PAYLOAD_SRC" ]; then
        [ -f "$PAYLOAD_SRC" ] || die "Payload file not found: $PAYLOAD_SRC"
        PAYLOAD=$(readlink -f "$PAYLOAD_SRC")
        say "Using local payload: $PAYLOAD"
    else
        command -v curl >/dev/null || die "curl is required to download the payload."
        PAYLOAD=$(mktemp /tmp/fasdeqos-payload.XXXXXX)
        PAYLOAD_TMP=1
        say "Downloading payload: $PAYLOAD_URL"
        if ! curl -fsSL "$PAYLOAD_URL" -o "$PAYLOAD"; then
            die "Could not download the payload from $PAYLOAD_URL
       Put fasdeqos-payload.tar.zst next to this script or run:
       sudo ./fasdeqos-migrate --payload /path/to/fasdeqos-payload.tar.zst"
        fi
    fi
    [ -s "$PAYLOAD" ] || die "The payload file is empty: $PAYLOAD"
    if command -v zstd >/dev/null; then
        zstd -tq "$PAYLOAD" || die "The payload is not a valid .zst archive: $PAYLOAD"
    fi
}

choose_mode() {
    local answer
    if [ "$ASSUME_YES" -eq 1 ]; then
        MODE=${MODE:-backup}
        USERLAND=${USERLAND:-chimerautils}
        SEAL=${SEAL:-open}
    fi
    if [ -z "$MODE" ]; then
        printf '\n1) Without backup (recommended)\n   Everything moves into the FasdeqOS layout and the old system is deleted right away.\n   A "FasdeqOS snapshot" boot entry stays as a fallback.\n\n2) With backup\n   Everything is copied into the FasdeqOS layout. The old system stays untouched.\n\n'
        read -rp "Choose 1 or 2: " answer
        case $answer in
            1) MODE=clean ;;
            2) MODE=backup ;;
            *) die "Invalid choice." ;;
        esac
    fi
    if [ "$MODE" = clean ] && [ -z "$USERLAND" ]; then
        printf '\nBase utilities that replace GNU:\n\n1) chimerautils (BSD userland)\n2) busybox\n\n'
        read -rp "Choose 1 or 2: " answer
        case $answer in
            1) USERLAND=chimerautils ;;
            2) USERLAND=busybox ;;
            *) die "Invalid choice." ;;
        esac
    fi
    if [ -z "$SEAL" ]; then
        printf '\nSystem volume (/System):\n\n1) Open: read-write, you can change anything\n2) Sealed: read-only, run fasdeqos-unlock to change it temporarily\n\n'
        read -rp "Choose 1 or 2: " answer
        case $answer in
            1) SEAL=open ;;
            2) SEAL=sealed ;;
            *) die "Invalid choice." ;;
        esac
    fi
}

confirm() {
    local answer
    printf '\nBoot loaders to edit:%s\n' "$LOADERS"
    if [ "$WINDOWS" -eq 1 ]; then
        printf 'Windows Boot Manager found: yes (dual boot)\n'
    else
        printf 'Windows Boot Manager found: no\n'
    fi
    if [ "$EXPERIMENTAL" -eq 1 ]; then
        printf '\nOmarchy support is EXPERIMENTAL.\n'
        if [ "$ASSUME_YES" -ne 1 ]; then
            printf 'Type EXPERIMENTAL to continue: '
            read -r answer
            [ "$answer" = EXPERIMENTAL ] || die "Cancelled."
        fi
    fi
    if [ "$ASSUME_YES" -eq 1 ]; then
        return 0
    fi
    if [ "$MODE" = clean ]; then
        printf '\nThe old system will be deleted and the computer will reboot into FasdeqOS.\n'
    fi
    printf '\nThis changes the layout of your disk. Type MIGRATE to continue: '
    read -r answer
    [ "$answer" = MIGRATE ] || die "Cancelled."
}

prepare() {
    local extra=""
    say "Installing required packages"
    if [ "$USERLAND" = busybox ]; then
        extra=busybox
    fi
    pacman -S --needed --noconfirm fish libarchive zstd mkinitcpio btrfs-progs curl pacman-contrib util-linux podman distrobox $extra
    UUID=$(blkid -s UUID -o value "$DEV")
    ESP_UUID=$(blkid -s UUID -o value "$ESP_DEV")
    if [ "$MODE" = clean ] && [ "$(findmnt -no TARGET -T /boot)" = "/" ]; then
        die "/boot is part of the root filesystem. Use --backup, or move /boot to the EFI partition first."
    fi
    bsdtar -tf "$PAYLOAD" ./usr/bin/pkg >/dev/null 2>&1 || die "The payload does not look like a FasdeqOS payload (./usr/bin/pkg is missing)."
}

make_volumes() {
    local v have=0
    say "Creating btrfs volumes"
    mkdir -p "$TOP"
    mountpoint -q "$TOP" || mount -o subvolid=5 "$DEV" "$TOP"
    for v in $VOLUMES; do
        if [ -e "$TOP/$v" ]; then
            have=$((have + 1))
        fi
    done
    if [ "$have" -eq 0 ]; then
        for v in $VOLUMES; do
            btrfs subvolume create "$TOP/$v" >/dev/null
        done
        return 0
    fi
    if [ "$have" -eq 6 ] && [ -f "$TOP/root/.hidden" ] && [ -x "$TOP/System/bin/pkg" ] && [ -e "$TOP/private/etc/fstab" ]; then
        RESUME=1
        say "Volumes and files already prepared, skipping to the boot entries"
        return 0
    fi
    die "Incomplete FasdeqOS volumes found on the btrfs top level. Delete them first:
       btrfs subvolume delete $TOP/root $TOP/System $TOP/Applications $TOP/Library $TOP/Users $TOP/private"
}

clone() {
    mkdir -p "$2"
    cp -a --reflink=auto "$1/." "$2/"
}

copy_files() {
    local d
    say "Copying files into the new layout"
    clone /usr "$TOP/System"
    mkdir -p "$TOP/System/Boot" "$TOP/System/opt"
    clone /etc "$TOP/private/etc"
    clone /var "$TOP/private/var"
    clone /root "$TOP/private/var/root"
    clone /home "$TOP/Users"
    if [ -d /opt ]; then
        clone /opt "$TOP/System/opt"
    fi
    if [ -d /srv ]; then
        clone /srv "$TOP/Library/srv"
    fi
    mkdir -p "$TOP/private/tmp" "$TOP/Library/Receipts"
    chmod 1777 "$TOP/private/tmp"
    for d in System Applications Library Users private Volumes usr etc var tmp; do
        mkdir -p "$TOP/root/$d"
    done
    ln -sfn usr/lib "$TOP/root/lib"
    ln -sfn usr/lib "$TOP/root/lib64"
    ln -sfn usr/bin "$TOP/root/bin"
    ln -sfn usr/bin "$TOP/root/sbin"
}

save_gnu() {
    local p f dst=$TOP/Library/gnu-userland
    say "Saving the GNU userland for compatibility bundles"
    mkdir -p "$dst/bin"
    for p in $GNU_PKGS bash; do
        pacman -Qq "$p" >/dev/null 2>&1 || continue
        while IFS= read -r f; do
            case $f in
                /usr/bin/?*)
                    if [ -f "$f" ] || [ -L "$f" ]; then
                        cp -a "$f" "$dst/bin/"
                    fi ;;
            esac
        done < <(pacman -Qlq "$p")
    done
    if [ -x /usr/bin/getopt ]; then
        cp -a /usr/bin/getopt "$dst/bin/"
    fi
}

remove_gnu() {
    local p f ver
    say "Removing GNU utilities"
    for p in $GNU_PKGS; do
        pacman -Qq "$p" >/dev/null 2>&1 || continue
        while IFS= read -r f; do
            case $f in
                /usr/*)
                    if [ -f "$TOP/System/${f#/usr/}" ] || [ -L "$TOP/System/${f#/usr/}" ]; then
                        rm -f "$TOP/System/${f#/usr/}"
                    fi ;;
            esac
        done < <(pacman -Qlq "$p")
        ver=$(pacman -Q "$p" | cut -d' ' -f2)
        rm -rf "$TOP/private/var/lib/pacman/local/$p-$ver"
    done
}

eligible() {
    local p=$1 files=$2
    if ! grep -q '^/usr/share/applications/.*\.desktop$' <<< "$files"; then
        return 1
    fi
    if grep -q '^/\(etc\|boot\)/' <<< "$files"; then
        return 1
    fi
    if grep -q '^/opt/' <<< "$files" && ! in_list "$p" "$COMPAT_PKGS"; then
        return 1
    fi
    return 0
}

dep_movable() {
    local files
    files=$(pacman -Qlq "$1" 2>/dev/null || true)
    if ! grep -q '^/usr/' <<< "$files"; then
        return 1
    fi
    if grep -q '^/\(etc\|boot\|var\|opt\)/' <<< "$files"; then
        return 1
    fi
    return 0
}

exclusive_deps() {
    local p=$1 closure d x ok
    closure=$(pactree -u "$p" 2>/dev/null | sort -u || true)
    for d in $closure; do
        if [ "$d" = "$p" ]; then
            continue
        fi
        ok=1
        for x in $(pactree -u -r "$d" 2>/dev/null); do
            if ! grep -qx "$x" <<< "$closure"; then
                ok=0
                break
            fi
        done
        if [ "$ok" -eq 1 ]; then
            echo "$d"
        fi
    done
}

move_pkg_files() {
    local b=$1 p=$2 f rel src dst ver files
    files=$(pacman -Qlq "$p")
    while IFS= read -r f; do
        case $f in
            /usr/*)
                rel=${f#/usr/}
                src=$TOP/System/$rel
                dst=$b/usr/$rel ;;
            /opt/*)
                rel=${f#/opt/}
                src=$TOP/System/opt/$rel
                dst=$b/opt/$rel ;;
            *) continue ;;
        esac
        if [ -d "$src" ] && [ ! -L "$src" ]; then
            mkdir -p "$dst"
        elif [ -e "$src" ] || [ -L "$src" ]; then
            mkdir -p "$(dirname "$dst")"
            cp -a --reflink=auto "$src" "$dst"
            rm -f "$src"
        fi
    done <<< "$files"
    ver=$(pacman -Q "$p" | cut -d' ' -f2)
    if [ -d "$TOP/private/var/lib/pacman/local/$p-$ver" ]; then
        mv "$TOP/private/var/lib/pacman/local/$p-$ver" "$b/.db/own/"
    fi
}

bundle_apps() {
    local p name b d names uidgid files
    say "Moving applications and games into /Applications"
    uidgid=$(awk -F: '$3 >= 1000 && $3 < 60000 {print $3 ":" $4; exit}' /etc/passwd)
    uidgid=${uidgid:-0:0}
    TOOLS_TMP=$(mktemp -d /tmp/fasdeqos-tools.XXXXXX)
    tool_compat > "$TOOLS_TMP/compat.sh"
    for p in $(pacman -Qqet); do
        case $p in
            fish|sudo|networkmanager|grub|mkinitcpio|busybox|pacman-contrib) continue ;;
        esac
        files=$(pacman -Qlq "$p")
        eligible "$p" "$files" || continue
        name=$(bundle_name "$p")
        b=$TOP/Applications/$name.pkg
        mkdir -p "$b/.db/own"
        names=$p
        move_pkg_files "$b" "$p"
        for d in $(exclusive_deps "$p"); do
            if dep_movable "$d"; then
                move_pkg_files "$b" "$d"
                names="$names $d"
            fi
        done
        printf 'bundle=%s\nrequested=%s\npackages=%s\nstate=installed\n' "$name" "$p" "$names" > "$TOP/Library/Receipts/$name.receipt"
        if [ "$MODE" = clean ] && in_list "$p" "$COMPAT_PKGS"; then
            FASDEQOS_APPS=$TOP/Applications FASDEQOS_LIB=$TOP/Library sh "$TOOLS_TMP/compat.sh" "$name"
        fi
        chown -R "$uidgid" "$b"
        say "  $name.pkg"
    done
    chown "$uidgid" "$TOP/Applications"
    chmod 775 "$TOP/Applications"
}

install_userland() {
    local sys=$TOP/System a
    if [ "$MODE" != clean ]; then
        bsdtar -xpf "$PAYLOAD" -C "$sys" --strip-components=2 ./usr/bin/pkg
        return 0
    fi
    if [ "$USERLAND" = busybox ]; then
        bsdtar -xpf "$PAYLOAD" -C "$sys" --strip-components=2 ./usr/bin/pkg
        install -m 755 /usr/bin/busybox "$sys/bin/busybox"
        for a in $(/usr/bin/busybox --list); do
            if [ ! -e "$sys/bin/$a" ] && [ ! -L "$sys/bin/$a" ]; then
                ln -s busybox "$sys/bin/$a"
            fi
        done
    else
        bsdtar -xpf "$PAYLOAD" -C "$sys" --strip-components=2 ./usr
        if [ -x /usr/bin/getopt ]; then
            cp -a /usr/bin/getopt "$sys/bin/getopt"
        fi
        if [ -x "$sys/bin/bsdtar" ] && [ ! -e "$sys/bin/tar" ]; then
            cp "$sys/bin/bsdtar" "$sys/bin/tar"
        fi
    fi
    mkdir -p "$sys/lib/fasdeqos"
    if [ -e "$sys/bin/pacman" ]; then
        mv "$sys/bin/pacman" "$sys/lib/fasdeqos/pacman"
    fi
}

setup_subids() {
    local u f
    u=$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1; exit}' /etc/passwd)
    [ -n "$u" ] || return 0
    for f in subuid subgid; do
        touch "$TOP/private/etc/$f"
        if ! grep -q "^$u:" "$TOP/private/etc/$f"; then
            printf '%s:100000:65536\n' "$u" >> "$TOP/private/etc/$f"
        fi
    done
}

convert() {
    local sys=$TOP/System priv=$TOP/private
    say "Applying the FasdeqOS layout"
    install_userland
    : > "$priv/etc/fstab"
    mkdir -p "$priv/etc/tmpfiles.d" "$priv/etc/modules-load.d" "$priv/etc/default" "$priv/etc/fish"
    : > "$priv/etc/tmpfiles.d/home.conf"
    : > "$priv/etc/tmpfiles.d/root.conf"
    printf 'dm_mod\n' > "$priv/etc/modules-load.d/fasdeqos.conf"
    printf 'SHELL=/usr/bin/fish\nHOME=/Users\n' > "$priv/etc/default/useradd"
    printf 'set -g fish_greeting\nset -gx PATH /usr/bin\n' > "$priv/etc/fish/config.fish"
    sed -i 's#:/home/#:/Users/#; s#:/usr/bin/bash$#:/usr/bin/fish#; s#:/bin/bash$#:/usr/bin/fish#' "$priv/etc/passwd"
    grep -qx /usr/bin/fish "$priv/etc/shells" || echo /usr/bin/fish >> "$priv/etc/shells"
    printf 'usr\nbin\nsbin\nlib\nlib64\nopt\netc\nvar\ntmp\nprivate\ndev\nproc\nsys\nrun\n' > "$TOP/root/.hidden"
    fix_shebangs "$sys"
    write_os_release
    write_tools
    setup_subids
}

make_snapshots() {
    local v d=$TOP/$SNAPDIR/$SNAPNAME
    if [ -d "$d" ]; then
        return 0
    fi
    say "Creating the FasdeqOS snapshot"
    mkdir -p "$d"
    for v in $VOLUMES; do
        btrfs subvolume snapshot "$TOP/$v" "$d/$v" >/dev/null
    done
}

pick_kernel() {
    local d
    if [ -f "/usr/lib/modules/$(uname -r)/vmlinuz" ]; then
        KVER=$(uname -r)
    else
        for d in $(ls -1 /usr/lib/modules 2>/dev/null | sort -V -r); do
            if [ -f "/usr/lib/modules/$d/vmlinuz" ]; then
                KVER=$d
                break
            fi
        done
    fi
    [ -n "$KVER" ] || die "No installed kernel found in /usr/lib/modules (is a kernel package installed?)."
    say "Using kernel $KVER"
}

place_kernel() {
    mkdir -p "$1"
    cp "/usr/lib/modules/$KVER/vmlinuz" "$1/vmlinuz"
    cp "$INITRAMFS" "$1/initramfs.img"
}

set_kv() {
    local file=$1 key=$2 val=$3
    if [ ! -f "$file" ]; then
        return 0
    fi
    if grep -q "^$key=" "$file"; then
        sed "s|^$key=.*|$key=$val|" "$file" > "$file.fix"
        cat "$file.fix" > "$file"
        rm -f "$file.fix"
    else
        printf '%s=%s\n' "$key" "$val" >> "$file"
    fi
}

write_grub_scripts() {
    local dir=$1
    mkdir -p "$dir"
    cat > "$dir/09_fasdeqos" <<GRUBENT
#!/bin/sh
cat <<'MENU'
menuentry "FasdeqOS" {
    insmod part_gpt
    insmod fat
    search --no-floppy --fs-uuid --set=root $ESP_UUID
    linux /fasdeqos/vmlinuz $CMDLINE
    initrd /fasdeqos/initramfs.img
}
MENU
GRUBENT
    rm -f "$dir/11_fasdeqos_windows"
    if [ "$WINDOWS" -eq 1 ]; then
        cat > "$dir/11_fasdeqos_windows" <<GRUBENT
#!/bin/sh
cat <<'MENU'
menuentry "Windows Boot Manager" {
    insmod part_gpt
    insmod fat
    insmod chain
    search --no-floppy --fs-uuid --set=root $WIN_UUID
    chainloader $WIN_FILE
}
MENU
GRUBENT
    fi
    cat > "$dir/12_fasdeqos_snapshot" <<GRUBENT
#!/bin/sh
cat <<'MENU'
menuentry "FasdeqOS snapshot" {
    insmod part_gpt
    insmod fat
    search --no-floppy --fs-uuid --set=root $ESP_UUID
    linux /fasdeqos/vmlinuz $SNAPCMDLINE
    initrd /fasdeqos/initramfs.img
}
MENU
GRUBENT
    cat > "$dir/13_fasdeqos_uefi" <<'GRUBENT'
#!/bin/sh
cat <<'MENU'
menuentry "UEFI Firmware Settings" {
    fwsetup
}
MENU
GRUBENT
    chmod +x "$dir"/09_fasdeqos "$dir"/12_fasdeqos_snapshot "$dir"/13_fasdeqos_uefi
    if [ -f "$dir/11_fasdeqos_windows" ]; then
        chmod +x "$dir/11_fasdeqos_windows"
    fi
}

prepare_grub_dir() {
    local dir=$1 f
    write_grub_scripts "$dir/grub.d"
    for f in "$dir"/grub.d/*; do
        case $(basename "$f") in
            00_*|01_*|*fasdeqos*|README) continue ;;
            30_os-prober) chmod -x "$f" ;;
            *)
                if [ "$MODE" = clean ]; then
                    chmod -x "$f"
                fi ;;
        esac
    done
    set_kv "$dir/default/grub" GRUB_DEFAULT 0
    set_kv "$dir/default/grub" GRUB_SAVEDEFAULT false
    set_kv "$dir/default/grub" GRUB_DISABLE_OS_PROBER true
}

boot_grub() {
    say "Adding FasdeqOS to GRUB ($GRUB_CFG)"
    prepare_grub_dir /etc
    prepare_grub_dir "$TOP/private/etc"
    grub-mkconfig -o "$GRUB_CFG"
    grep -q 'menuentry "FasdeqOS"' "$GRUB_CFG" || die "The FasdeqOS entry did not appear in $GRUB_CFG."
}

boot_limine() {
    local conf=$LIMINE_CONF tmp prefix wprefix cfgprefix wcfgprefix
    say "Adding FasdeqOS to Limine ($conf)"
    tmp=$(mktemp /tmp/fasdeqos-limine.XXXXXX)
    if [ ! -e "$conf.fasdeqos-backup" ]; then
        cp -a "$conf" "$conf.fasdeqos-backup"
    fi
    if [ "$(findmnt -no SOURCE -T "$conf")" = "$ESP_DEV" ]; then
        prefix='boot():'
        cfgprefix='boot://'
    else
        prefix="guid($ESP_PARTUUID):"
        cfgprefix="guid://$ESP_PARTUUID"
    fi
    if [ "$WIN_PARTUUID" = "$ESP_PARTUUID" ] && [ "$prefix" = 'boot():' ]; then
        wprefix='boot():'
        wcfgprefix='boot://'
    else
        wprefix="guid($WIN_PARTUUID):"
        wcfgprefix="guid://$WIN_PARTUUID"
    fi
    if [ "${conf##*.}" = conf ]; then
        {
            awk '/^\//{exit} {print}' "$conf" | grep -vi '^[[:space:]]*default_entry' || true
            printf 'default_entry: 1\n\n'
            printf '/FasdeqOS\n    protocol: linux\n    path: %s/fasdeqos/vmlinuz\n    cmdline: %s\n    module_path: %s/fasdeqos/initramfs.img\n\n' "$prefix" "$CMDLINE" "$prefix"
            if [ "$WINDOWS" -eq 1 ]; then
                printf '/Windows Boot Manager\n    protocol: efi\n    path: %s%s\n\n' "$wprefix" "$WIN_FILE"
            fi
            printf '/FasdeqOS snapshot\n    protocol: linux\n    path: %s/fasdeqos/vmlinuz\n    cmdline: %s\n    module_path: %s/fasdeqos/initramfs.img\n\n' "$prefix" "$SNAPCMDLINE" "$prefix"
            if [ "$MODE" != clean ]; then
                awk 'f||/^\//{f=1;print}' "$conf"
            fi
        } > "$tmp"
    else
        {
            awk '/^:/{exit} {print}' "$conf" | grep -vi '^[[:space:]]*default_entry' || true
            printf 'DEFAULT_ENTRY=1\n\n'
            printf ':FasdeqOS\n    PROTOCOL=linux\n    KERNEL_PATH=%s/fasdeqos/vmlinuz\n    CMDLINE=%s\n    MODULE_PATH=%s/fasdeqos/initramfs.img\n\n' "$cfgprefix" "$CMDLINE" "$cfgprefix"
            if [ "$WINDOWS" -eq 1 ]; then
                printf ':Windows Boot Manager\n    PROTOCOL=efi_chainload\n    IMAGE_PATH=%s%s\n\n' "$wcfgprefix" "$WIN_FILE"
            fi
            printf ':FasdeqOS snapshot\n    PROTOCOL=linux\n    KERNEL_PATH=%s/fasdeqos/vmlinuz\n    CMDLINE=%s\n    MODULE_PATH=%s/fasdeqos/initramfs.img\n\n' "$cfgprefix" "$SNAPCMDLINE" "$cfgprefix"
            if [ "$MODE" != clean ]; then
                awk 'f||/^:/{f=1;print}' "$conf"
            fi
        } > "$tmp"
    fi
    cat "$tmp" > "$conf"
    rm -f "$tmp"
}

boot_sdboot() {
    local dir=$SDB_ROOT/loader/entries lc=$SDB_ROOT/loader/loader.conf mid sdpart
    say "Adding FasdeqOS to systemd-boot ($SDB_ROOT)"
    mkdir -p "$dir"
    if [ "$SDB_ROOT" != "$ESP" ]; then
        place_kernel "$SDB_ROOT/fasdeqos"
    fi
    if [ "$MODE" = clean ]; then
        rm -f "$dir"/*.conf
        mid=$(cat /etc/machine-id 2>/dev/null || true)
        if [ -n "$mid" ] && [ -d "$SDB_ROOT/$mid" ]; then
            rm -rf "${SDB_ROOT:?}/$mid"
        fi
        rm -f "$ESP"/EFI/Linux/*.efi
    fi
    cat > "$dir/fasdeqos.conf" <<ENTRY
title FasdeqOS
sort-key a1-fasdeqos
linux /fasdeqos/vmlinuz
initrd /fasdeqos/initramfs.img
options $CMDLINE
ENTRY
    sdpart=$(blkid -s PARTUUID -o value "$(findmnt -no SOURCE "$SDB_ROOT")" || true)
    rm -f "$dir/windows.conf"
    if [ "$WINDOWS" -eq 1 ] && [ "$WIN_PARTUUID" = "$sdpart" ]; then
        cat > "$dir/windows.conf" <<ENTRY
title Windows Boot Manager
sort-key b1-windows
efi $WIN_FILE
ENTRY
    fi
    cat > "$dir/fasdeqos-snapshot.conf" <<ENTRY
title FasdeqOS snapshot
sort-key c1-snapshot
linux /fasdeqos/vmlinuz
initrd /fasdeqos/initramfs.img
options $SNAPCMDLINE
ENTRY
    touch "$lc"
    { printf 'default fasdeqos.conf\n'; grep -v '^[[:space:]]*default' "$lc" || true; } > "$lc.fix"
    cat "$lc.fix" > "$lc"
    rm -f "$lc.fix"
}

install_boot() {
    local l xb xdev
    say "Creating the boot entries"
    write_initcpio
    pick_kernel
    INITRAMFS=$(mktemp /tmp/fasdeqos-initramfs.XXXXXX)
    write_mkconf
    mkdir -p "$TOP/private/etc/initcpio/hooks" "$TOP/private/etc/initcpio/install"
    cp -a /etc/initcpio/hooks/fasdeqos-disk "$TOP/private/etc/initcpio/hooks/"
    cp -a /etc/initcpio/install/fasdeqos-disk "$TOP/private/etc/initcpio/install/"
    write_alpm
    xb=""
    if [ -n "$SDB_ROOT" ] && [ "$SDB_ROOT" != "$ESP" ]; then
        xdev=$(findmnt -no SOURCE "$SDB_ROOT" || true)
        if [ -n "$xdev" ] && [ "$xdev" != "$ESP_DEV" ]; then
            xb=$(blkid -s UUID -o value "$xdev" || true)
        fi
    fi
    write_boot_conf "$ESP_UUID" "$xb"
    if [ -f "/usr/lib/modules/$KVER/pkgbase" ]; then
        cp "/usr/lib/modules/$KVER/pkgbase" "$TOP/Library/kernel.pkgbase"
    fi
    mkinitcpio -c "$TOP/Library/mkinitcpio-fasdeqos.conf" -k "$KVER" -g "$INITRAMFS"
    place_kernel "$ESP/fasdeqos"
    CMDLINE="root=UUID=$UUID fasdeqos_esp=$ESP_UUID rw init=/System/lib/systemd/systemd firmware_class.path=/usr/lib/firmware quiet"
    if [ "$SEAL" = sealed ]; then
        CMDLINE="$CMDLINE fasdeqos_sealed=1"
    fi
    SNAPCMDLINE="$CMDLINE fasdeqos_snap=$SNAPDIR/$SNAPNAME/"
    for l in $LOADERS; do
        case $l in
            grub) boot_grub ;;
            limine) boot_limine ;;
            systemd-boot) boot_sdboot ;;
        esac
    done
}

schedule_purge() {
    local dir=$TOP/private/var/lib/fasdeqos list fsroot r s e
    say "Preparing the removal of the old system"
    mkdir -p "$dir" "$TOP/private/etc/systemd/system/multi-user.target.wants"
    list=$dir/purge
    : > "$list"
    fsroot=$(findmnt -no FSROOT / | sed 's/\[.*//')
    while read -r r s; do
        s=${s%%\[*}
        if [ "$s" = "$DEV" ] && [ "$r" != "/" ]; then
            printf 'subvol %s\n' "${r#/}" >> "$list"
        fi
    done < <(findmnt -rn -t btrfs -o FSROOT,SOURCE)
    if [ "$fsroot" = "/" ]; then
        for e in $(ls -A "$TOP"); do
            case " $VOLUMES lost+found $SNAPDIR " in
                *" $e "*) continue ;;
            esac
            if grep -q "^subvol $e\$" "$list"; then
                continue
            fi
            printf 'entry %s\n' "$e" >> "$list"
        done
    fi
    sort -u "$list" -o "$list"
    cat > "$TOP/System/bin/fasdeqos-purge" <<'PURGE'
#!/usr/bin/env sh
top=/run/fasdeqos-top
src=$(findmnt -no SOURCE /System)
dev=${src%%\[*}
[ -n "$dev" ] || exit 1
mkdir -p "$top"
mount -o subvolid=5 "$dev" "$top" || exit 1
while read -r kind name; do
    case $name in
        ""|root|System|Applications|Library|Users|private|lost+found|.fasdeqos-snapshots) continue ;;
    esac
    case $kind in
        subvol)
            if [ -e "$top/$name" ]; then
                btrfs subvolume delete --recursive "$top/$name"
            fi ;;
        entry)
            rm -rf "$top/$name" ;;
    esac
done < /var/lib/fasdeqos/purge
btrfs subvolume sync "$top" >/dev/null 2>&1
umount "$top"
rm -f /var/lib/fasdeqos/purge
exit 0
PURGE
    chmod +x "$TOP/System/bin/fasdeqos-purge"
    cat > "$TOP/private/etc/systemd/system/fasdeqos-purge.service" <<'UNIT'
[Unit]
Description=Remove the previous system
ConditionPathExists=/var/lib/fasdeqos/purge
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/bin/sh /usr/bin/fasdeqos-purge

[Install]
WantedBy=multi-user.target
UNIT
    ln -sf /etc/systemd/system/fasdeqos-purge.service "$TOP/private/etc/systemd/system/multi-user.target.wants/fasdeqos-purge.service"
}

purge_now() {
    local list=$TOP/private/var/lib/fasdeqos/purge rest rootsub kind name left=0
    [ -s "$list" ] || return 0
    say "Deleting the old system"
    rootsub=$(findmnt -no FSROOT / | sed 's/\[.*//')
    rootsub=${rootsub#/}
    rest=$(mktemp /tmp/fasdeqos-rest.XXXXXX)
    while read -r kind name; do
        if [ "$kind" != subvol ]; then
            printf '%s %s\n' "$kind" "$name" >> "$rest"
            left=1
            continue
        fi
        if [ "$name" = "$rootsub" ] || [ -z "$name" ]; then
            continue
        fi
        if [ ! -e "$TOP/$name" ]; then
            continue
        fi
        if ! btrfs subvolume delete --recursive "$TOP/$name" >/dev/null; then
            printf 'subvol %s\n' "$name" >> "$rest"
            left=1
        fi
    done < "$list"
    if [ -n "$rootsub" ]; then
        printf 'subvol %s\n' "$rootsub" >> "$rest"
    fi
    cat "$rest" > "$list"
    rm -f "$rest"
    if [ -z "$rootsub" ]; then
        if [ "$left" -eq 1 ]; then
            say "Some old files remain and are removed after the first boot."
        fi
        return 0
    fi
    printf '==> The old system will be deleted now and the computer reboots into FasdeqOS. Press Ctrl+C within 10 seconds to cancel.\n'
    read -r -t 10 _ || true
    sync
    echo 1 > /proc/sys/kernel/sysrq
    exec 3>/proc/sysrq-trigger
    cleanup
    trap - EXIT
    if btrfs subvolume delete --recursive "$TOP/$rootsub" >/dev/null 2>&1; then
        echo s >&3
        echo u >&3
        echo b >&3
        read -r _ || true
    else
        exec 3>&-
        say "The running system cannot be deleted while it is in use. It is removed after the first boot."
    fi
}

finish() {
    say "Migration complete."
    if [ "$MODE" = clean ]; then
        purge_now
        say "Reboot and choose FasdeqOS."
        umount "$TOP"
    else
        umount "$TOP"
        say "Reboot and choose FasdeqOS. Your old system is untouched."
    fi
}

while [ $# -gt 0 ]; do
    case $1 in
        --backup) MODE=backup ;;
        --no-backup) MODE=clean ;;
        --yes) ASSUME_YES=1 ;;
        --open) SEAL=open ;;
        --sealed) SEAL=sealed ;;
        --chimerautils) USERLAND=chimerautils ;;
        --busybox) USERLAND=busybox ;;
        --payload)
            [ $# -ge 2 ] || die "--payload needs a file path or URL."
            PAYLOAD_SRC=$2
            shift ;;
        --payload=*) PAYLOAD_SRC=${1#--payload=} ;;
        --update) UPDATE=1 ;;
        *) die "Unknown option: $1" ;;
    esac
    shift
done

if [ "$UPDATE" -eq 1 ] || { [ -d /System ] && [ -d /Applications ] && grep -qx 'ID=fasdeqos' /etc/os-release 2>/dev/null; }; then
    update_system
    exit 0
fi

check_system
resolve_payload
choose_mode
confirm
prepare
make_volumes
if [ "$RESUME" -eq 0 ]; then
    copy_files
    if [ "$MODE" = clean ]; then
        save_gnu
        remove_gnu
    fi
    bundle_apps
    convert
fi
make_snapshots
install_boot
if [ "$MODE" = clean ]; then
    schedule_purge
fi
finish
