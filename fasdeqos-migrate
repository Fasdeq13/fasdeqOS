tool_kernel() {
    cat <<'KERNEL'
#!/usr/bin/env sh
if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi
LIB=${FASDEQOS_LIB:-/Library}
MODS=${FASDEQOS_MODS:-/usr/lib/modules}
LOGF=${FASDEQOS_KLOG:-/var/log/fasdeqos-kernel.log}
CONF=$LIB/boot.conf
if [ ! -f "$CONF" ]; then
    printf 'The boot configuration is missing: %s\n' "$CONF" >&2
    exit 0
fi
. "$CONF"
if [ -d "$LIB/gnu-userland/bin" ]; then
    PATH=$LIB/gnu-userland/bin:$PATH
    export PATH
fi
list_kernels() {
    for d in $(ls -1 "$MODS" 2>/dev/null | sort -V); do
        if [ ! -f "$MODS/$d/vmlinuz" ]; then
            continue
        fi
        pb=$(cat "$MODS/$d/pkgbase" 2>/dev/null || echo unknown)
        printf '%s %s\n' "$pb" "$d"
    done
}
ensure_mount() {
    if ! grep -q " $1 " /proc/mounts; then
        mkdir -p "$1"
        mount "UUID=$2" "$1" || return 1
    fi
    return 0
}
install_to() {
    d=$1/fasdeqos
    mkdir -p "$d"
    cp "$MODS/$best/vmlinuz" "$d/vmlinuz.new" || return 1
    cp "$img" "$d/initramfs.img.new" || return 1
    mv "$d/vmlinuz.new" "$d/vmlinuz"
    mv "$d/initramfs.img.new" "$d/initramfs.img"
    return 0
}
sync_kernel() {
    list=$(mktemp /tmp/fasdeqos-klist.XXXXXX)
    list_kernels > "$list"
    pref=$(cat "$LIB/kernel.pkgbase" 2>/dev/null || true)
    best=""
    bestpb=""
    while read -r pb d; do
        if [ -z "$pref" ] || [ "$pb" = "$pref" ]; then
            best=$d
            bestpb=$pb
        fi
    done < "$list"
    if [ -z "$best" ]; then
        while read -r pb d; do
            best=$d
            bestpb=$pb
        done < "$list"
    fi
    rm -f "$list"
    if [ -z "$best" ]; then
        printf 'No installed kernel was found, the boot files stay as they are.\n'
        return 0
    fi
    printf '%s\n' "$bestpb" > "$LIB/kernel.pkgbase"
    img=$(mktemp /tmp/fasdeqos-initramfs.XXXXXX)
    if ! mkinitcpio -c "$LIB/mkinitcpio-fasdeqos.conf" -k "$best" -g "$img" > "$LOGF" 2>&1 || [ ! -s "$img" ]; then
        rm -f "$img"
        printf 'Could not build the initramfs for %s. The previous kernel stays in use. Log: %s\n' "$best" "$LOGF"
        return 1
    fi
    if ! ensure_mount "$ESP_MOUNT" "$ESP_UUID"; then
        rm -f "$img"
        printf 'Could not mount the boot partition.\n'
        return 1
    fi
    install_to "$ESP_MOUNT" || { rm -f "$img"; printf 'Could not write the boot files.\n'; return 1; }
    if [ -n "${XBOOT_UUID:-}" ]; then
        if ensure_mount /run/fasdeqos-xboot "$XBOOT_UUID"; then
            install_to /run/fasdeqos-xboot || true
            umount /run/fasdeqos-xboot 2>/dev/null || true
        fi
    fi
    rm -f "$img"
    sync
    printf 'Kernel %s is ready for the next boot.\n' "$best"
    return 0
}
cmd=${1:-sync}
if [ $# -gt 0 ]; then
    shift
fi
case $cmd in
    list)
        cur=$(cat "$LIB/kernel.pkgbase" 2>/dev/null || true)
        list_kernels | while read -r pb d; do
            mark=" "
            if [ "$pb" = "$cur" ]; then
                mark="*"
            fi
            printf '%s %s (%s)\n' "$mark" "$pb" "$d"
        done
        exit 0 ;;
    use)
        want=${1:-}
        if ! list_kernels | grep -q "^$want "; then
            printf 'That kernel is not installed. See: pkg kernel list\n'
            exit 1
        fi
        printf '%s\n' "$want" > "$LIB/kernel.pkgbase"
        sync_kernel
        exit $? ;;
    sync)
        sync_kernel
        exit $? ;;
    *)
        printf 'Usage: pkg kernel [list|use <name>|sync]\n'
        exit 1 ;;
esac
KERNEL
}

