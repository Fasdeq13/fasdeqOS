VOLUMES="root System Applications Library Users private"
GNU_PKGS="coreutils grep sed findutils gawk diffutils gzip tar which"
COMPAT_PKGS=${FASDEQOS_COMPAT:-"steam davinci-resolve davinci-resolve-studio"}
HEAVY_PKGS=${FASDEQOS_HEAVY:-"steam blender davinci-resolve davinci-resolve-studio"}
