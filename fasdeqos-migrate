update_system() {
    local relock=0 esp_dev esp_uuid
    [ "$(id -u)" -eq 0 ] || die "Run this script as root."
    say "FasdeqOS is already installed, updating its tools"
    TOP=""
    UPD=1
    if ! touch /System/.fasdeqos-w 2>/dev/null; then
        sh /System/bin/fasdeqos-unlock >/dev/null 2>&1 || true
        relock=1
    fi
    touch /System/.fasdeqos-w 2>/dev/null || die "The system volume is sealed. Run fasdeqos-unlock and try again."
    rm -f /System/.fasdeqos-w
    write_initcpio
    write_tools
    write_alpm
    write_mkconf
    if [ ! -f /Library/boot.conf ]; then
        esp_dev=$(findmnt -no SOURCE /System/Boot || true)
        [ -n "$esp_dev" ] || die "The boot partition is not mounted at /System/Boot."
        esp_uuid=$(blkid -s UUID -o value "$esp_dev")
        write_boot_conf "$esp_uuid"
    fi
    if [ ! -s /Library/kernel.pkgbase ] && [ -f "/usr/lib/modules/$(uname -r)/pkgbase" ]; then
        cp "/usr/lib/modules/$(uname -r)/pkgbase" /Library/kernel.pkgbase
    fi
    sh /System/bin/fasdeqos-kernel sync || say "The kernel files were not refreshed, see /var/log/fasdeqos-kernel.log"
    sh /System/bin/fasdeqos-union >/dev/null 2>&1 || true
    if [ "$relock" -eq 1 ]; then
        sh /System/bin/fasdeqos-lock >/dev/null 2>&1 || true
    fi
    say "Update complete."
}

tool_hook() {
    cat <<'HOOK'
run_hook() {
    mount_handler=fasdeqos_disk_mount_handler
}

fasdeqos_disk_mount_handler() {
    newroot=$1
    dev=/dev/disk/by-uuid/${root#UUID=}
    pre=${fasdeqos_snap:-}
    waited=0
    while [ ! -b "$dev" ] && [ "$waited" -lt 30 ]; do
        udevadm settle --timeout=1
        sleep 1
        waited=$((waited + 1))
    done
    btrfs device scan
    opts=compress=zstd:1,noatime
    mount -t btrfs -o "$opts,subvol=${pre}root" "$dev" "$newroot" || echo "fasdeqos: mount root failed"
    for v in System Applications Library Users private; do
        mount -t btrfs -o "$opts,subvol=${pre}$v" "$dev" "$newroot/$v" || echo "fasdeqos: mount $v failed"
    done
    if [ -n "$fasdeqos_esp" ]; then
        mkdir -p "$newroot/System/Boot" 2>/dev/null
        mount -t vfat "/dev/disk/by-uuid/$fasdeqos_esp" "$newroot/System/Boot" || echo "fasdeqos: ESP mount failed"
    fi
    klog() {
        echo "fasdeqos: $*" > /dev/kmsg 2>/dev/null
        echo "fasdeqos: $*"
    }
    modprobe overlay 2>/dev/null
    plus="lowerdir+=$newroot/System"
    classic="$newroot/System"
    count=0
    for b in "$newroot"/Applications/*.pkg; do
        if [ -d "$b/usr" ]; then
            plus="$plus,lowerdir+=$b/usr"
            classic="$classic:$b/usr"
            count=$((count + 1))
        fi
    done
    ok=0
    if [ "$count" -gt 0 ]; then
        if out=$(mount -t overlay overlay -o "$plus" "$newroot/usr" 2>&1); then
            ok=1
            klog "overlay mounted"
        elif out2=$(mount -t overlay overlay -o "lowerdir=$classic" "$newroot/usr" 2>&1); then
            ok=1
            klog "overlay mounted (classic)"
        else
            klog "overlay failed: $out / $out2"
        fi
    fi
    if [ "$ok" -eq 0 ]; then
        mount --bind "$newroot/System" "$newroot/usr" || klog "bind /usr failed"
    fi
    if [ ! -e "$newroot/usr/lib/ld-linux-x86-64.so.2" ]; then
        klog "ld.so missing after mount, using plain /System"
        umount "$newroot/usr" 2>/dev/null
        mount --bind "$newroot/System" "$newroot/usr" || klog "bind /usr failed"
    fi
    for m in "private/etc etc" "private/var var" "private/tmp tmp"; do
        set -- $m
        mount --bind "$newroot/$1" "$newroot/$2" || klog "bind $1 to $2 failed"
    done
    if [ -d "$newroot/usr/opt" ]; then
        mkdir -p "$newroot/opt"
        mount --bind "$newroot/usr/opt" "$newroot/opt"
    fi
    echo /usr/bin/modprobe > /proc/sys/kernel/modprobe
    if [ "${fasdeqos_sealed:-0}" = 1 ]; then
        for t in System usr opt; do
            if [ -e "$newroot/$t" ]; then
                mount -o remount,bind,ro "$newroot/$t" 2>/dev/null
            fi
        done
        klog "system volume sealed (read-only)"
    fi
}
HOOK
}

