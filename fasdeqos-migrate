die() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

say() {
    printf '==> %s\n' "$1"
}

cleanup() {
    if [ "$PAYLOAD_TMP" -eq 1 ] && [ -n "$PAYLOAD" ]; then
        rm -f "$PAYLOAD"
    fi
    if [ -n "$TOOLS_TMP" ]; then
        rm -rf "$TOOLS_TMP"
    fi
    if [ -n "$INITRAMFS" ]; then
        rm -f "$INITRAMFS"
    fi
}
trap cleanup EXIT

in_list() {
    case " $2 " in
        *" $1 "*) return 0 ;;
    esac
    return 1
}

bundle_name() {
    case $1 in
        vlc) echo VLC ;;
        gimp) echo GIMP ;;
        libreoffice-fresh) echo LibreOffice ;;
        telegram-desktop) echo Telegram ;;
        nautilus) echo Files ;;
        gnome-console) echo Console ;;
        gnome-text-editor) echo TextEditor ;;
        *) printf '%s%s\n' "$(printf '%s' "${1:0:1}" | tr a-z A-Z)" "${1:1}" ;;
    esac
}

fix_shebangs() {
    local f first rest pre
    grep -rIl '^#!/bin/' "$1" 2>/dev/null | while IFS= read -r f; do
        first=$(head -n1 "$f")
        case $first in
            "#!/bin/sh"|"#!/bin/sh "*|"#!/bin/bash"|"#!/bin/bash "*)
                rest=$(printf '%s\n' "$first" | cut -c8-)
                case $rest in
                    *" "*) pre='#!/usr/bin/env -S ' ;;
                    *) pre='#!/usr/bin/env ' ;;
                esac
                { printf '%s%s\n' "$pre" "$rest"; tail -n +2 "$f"; } > "$f.fix"
                cat "$f.fix" > "$f"
                rm -f "$f.fix" ;;
        esac
    done
}

tool_union() {
    cat <<'UNION'
#!/usr/bin/env sh
mode=${1:-rebuild}
union_one() {
    target=$1
    base=$2
    sub=$3
    [ -d "$base" ] || return 0
    opts="lowerdir+=$base"
    count=0
    for b in /Applications/*.pkg; do
        if [ -d "$b/$sub" ]; then
            opts="$opts,lowerdir+=$b/$sub"
            count=$((count + 1))
        fi
    done
    if [ "$count" -eq 0 ]; then
        if [ "$(findmnt -no FSTYPE "$target")" = overlay ]; then
            mount --bind "$base" "$target"
        fi
        return 0
    fi
    mount -t overlay overlay -o "$opts" "$target"
}
if [ "$mode" = boot ] && [ "$(findmnt -no FSTYPE /usr)" = overlay ]; then
    exit 0
fi
union_one /usr /System usr
union_one /opt /System/opt opt
ldconfig 2>/dev/null
exit 0
UNION
}

tool_compat() {
    cat <<'COMPAT'
#!/usr/bin/env sh
APPS=${FASDEQOS_APPS:-/Applications}
LIB=${FASDEQOS_LIB:-/Library}
RUNAPPS=/Applications
name=$1
b=$APPS/$name.pkg
if [ -z "$name" ] || [ ! -d "$b" ]; then
    echo "Usage: fasdeqos-compat <Bundle>" >&2
    exit 1
fi
if [ ! -d "$LIB/gnu-userland" ]; then
    echo "The GNU userland store is missing: $LIB/gnu-userland" >&2
    exit 1
fi
if [ ! -d "$b/gnu" ]; then
    mkdir -p "$b/gnu"
    cp -a "$LIB/gnu-userland/." "$b/gnu/"
fi
line="FASDEQOS_COMPAT=1; PATH=$RUNAPPS/$name.pkg/gnu/bin:\$PATH; export PATH FASDEQOS_COMPAT"
for f in "$b"/usr/bin/*; do
    if [ ! -f "$f" ] || [ -L "$f" ]; then
        continue
    fi
    first=$(head -n1 "$f")
    case $first in
        *fish*) continue ;;
        "#!"*sh*|"#!"*bash*) ;;
        *) continue ;;
    esac
    if grep -q 'FASDEQOS_COMPAT=1' "$f"; then
        continue
    fi
    { printf '%s\n' "$first"; printf '%s\n' "$line"; tail -n +2 "$f"; } > "$f.fix"
    cat "$f.fix" > "$f"
    rm -f "$f.fix"
done
for d in "$b"/usr/share/applications/*.desktop; do
    if [ ! -f "$d" ]; then
        continue
    fi
    if grep -q 'FASDEQOS_GNU=1' "$d"; then
        continue
    fi
    sed "s|^Exec=|Exec=env PATH=$RUNAPPS/$name.pkg/gnu/bin:/usr/bin:/bin FASDEQOS_GNU=1 |" "$d" > "$d.fix"
    cat "$d.fix" > "$d"
    rm -f "$d.fix"
done
exit 0
COMPAT
}

tool_libcheck() {
    cat <<'LIBCHECK'
#!/usr/bin/env sh
APPS=${FASDEQOS_APPS:-/Applications}
name=$1
b=$APPS/$name.pkg
[ -d "$b" ] || exit 1
lp=""
for d in "$b/usr/lib" "$b/usr/lib32" "$b/usr/lib64" "$b"/opt/*/lib "$b"/opt/*/bin; do
    if [ -d "$d" ]; then
        lp="$lp:$d"
    fi
done
status=0
for f in "$b"/usr/bin/* "$b"/opt/*/bin/*; do
    if [ ! -f "$f" ]; then
        continue
    fi
    if ! head -c4 "$f" 2>/dev/null | grep -q ELF; then
        continue
    fi
    missing=$(LD_LIBRARY_PATH="${lp#:}:/usr/lib" ldd "$f" 2>/dev/null | grep 'not found' || true)
    if [ -n "$missing" ]; then
        printf '%s is missing libraries:\n%s\n' "$f" "$missing" >&2
        status=1
    fi
done
exit $status
LIBCHECK
}

tool_lock() {
    cat <<'LOCK'
#!/usr/bin/env sh
mode=ro
case $(basename "$0") in
    *unlock*) mode=rw ;;
esac
if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi
findmnt -rn -t btrfs -o TARGET,SOURCE | while read -r t s; do
    case $s in
        *"[/System"*) mount -o "remount,bind,$mode" "$t" ;;
    esac
done
echo "System volume is now $mode."
exit 0
LOCK
}

tool_pkg() {
    cat <<'PKGW'
#!/usr/bin/env sh
if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi
BIN=${FASDEQOS_BIN:-/usr/bin}
REAL=${PKG_REAL:-$BIN/pkg-real}
LOG=${PKG_LOG:-/var/log/pkg-last.log}
APPS=${PKG_APPS:-/Applications}
LIBDIR=${PKG_LIBDIR:-/Library}
RECEIPTS=$LIBDIR/Receipts
VERBOSE=0
args=""
for a in "$@"; do
    if [ "$a" = --verbose ]; then
        VERBOSE=1
    else
        args="$args $a"
    fi
done
set -- $args
bundle_name() {
    case $1 in
        vlc) echo VLC ;;
        gimp) echo GIMP ;;
        libreoffice-fresh) echo LibreOffice ;;
        telegram-desktop) echo Telegram ;;
        nautilus) echo Files ;;
        gnome-console) echo Console ;;
        gnome-text-editor) echo TextEditor ;;
        *)
            first=$(printf '%s' "$1" | cut -c1 | tr a-z A-Z)
            rest=$(printf '%s' "$1" | cut -c2-)
            echo "$first$rest" ;;
    esac
}
user=${SUDO_USER:-}
home=""
if [ -n "$user" ]; then
    home=$(getent passwd "$user" | cut -d: -f6)
fi
as_user() {
    runuser -u "$user" -- env HOME="$home" XDG_RUNTIME_DIR="/run/user/$(id -u "$user")" "$@"
}
containers_ok() {
    [ -n "$user" ] && command -v distrobox >/dev/null 2>&1 && command -v podman >/dev/null 2>&1
}
is_heavy() {
    grep -qx "$1" "$LIBDIR/heavy.list" 2>/dev/null
}
REPODIR=$LIBDIR/Repos
valid_word() {
    case $1 in
        ""|*[!A-Za-z0-9._-]*) return 1 ;;
    esac
    return 0
}
valid_url() {
    case $1 in
        http://*|https://*) ;;
        *) return 1 ;;
    esac
    case $1 in
        *[!A-Za-z0-9._~:/?@\&$+,=%-]*) return 1 ;;
    esac
    return 0
}
repo_snippet() {
    for f in "$REPODIR"/*.repo; do
        if [ ! -f "$f" ]; then
            continue
        fi
        n=$(basename "$f" .repo)
        u=$(head -n1 "$f")
        printf '[%s]\nSigLevel = Optional TrustAll\nServer = %s\n' "$n" "$u"
    done
}
sync_repos() {
    mkdir -p "$REPODIR"
    conf=${PKG_PACMAN_CONF:-/etc/pacman.conf}
    extra=$(dirname "$conf")/pacman.d/fasdeqos-repos.conf
    if [ -d "$(dirname "$extra")" ]; then
        repo_snippet > "$extra"
        if [ -f "$conf" ] && ! grep -q 'fasdeqos-repos.conf' "$conf"; then
            printf '\nInclude = %s\n' "$extra" >> "$conf"
        fi
    fi
}
place_desktop() {
    b=$1
    ad=$b/usr/share/applications
    if [ ! -d "$ad" ]; then
        return 0
    fi
    for d in "$ad"/*.desktop; do
        if [ ! -f "$d" ] || [ -L "$d" ]; then
            continue
        fi
        bn=$(basename "$d")
        mv "$d" "$b/$bn"
        ln -s "$b/$bn" "$ad/$bn"
    done
    return 0
}
is_system() {
    case $1 in
        linux|linux-*|*-headers|nvidia|nvidia-*|*-dkms|mesa|lib32-*|mkinitcpio|mkinitcpio-*|systemd|systemd-*|linux-firmware*|grub|limine|efibootmgr|base|base-devel|dracut|vulkan-*|xf86-video-*|btrfs-progs|glibc|pacman|filesystem) return 0 ;;
    esac
    return 1
}
sys_pacman() {
    unshare -m sh -c 'mount --bind /System /usr || exit 97; if [ -d /System/opt ]; then mount --bind /System/opt /opt; fi; exec pacman "$@"' sh "$@"
}
sys_writable() {
    if touch /System/.pkg-w 2>/dev/null; then
        rm -f /System/.pkg-w
        return 0
    fi
    printf 'The system volume is sealed. Run fasdeqos-unlock first, then try again.\n'
    return 1
}
run_sys() {
    sys_writable || return 1
    if [ "$VERBOSE" -eq 1 ]; then
        sys_pacman "$@"
        return $?
    fi
    rcf=$(mktemp /tmp/pkg-rc.XXXXXX)
    { sys_pacman "$@"; echo $? > "$rcf"; } >>"$LOG" 2>&1
    rc=$(cat "$rcf")
    rm -f "$rcf"
    if [ "$rc" -ne 0 ]; then
        printf 'Something went wrong. Run the command again with --verbose or see %s\n' "$LOG"
    fi
    return "$rc"
}
field() {
    sed -n "s/^$2=//p" "$1"
}
raw_real() {
    PKG_NO_UNION=1 "$REAL" "$@"
}
run_real() {
    if [ "$VERBOSE" -eq 1 ]; then
        raw_real "$@"
        return $?
    fi
    rcf=$(mktemp /tmp/pkg-rc.XXXXXX)
    { raw_real "$@"; echo $? > "$rcf"; } 2>&1 | tee -a "$LOG" | grep -E '^(==>|Error:|.*is already installed|.*is not installed|.*is part of the system)' || true
    rc=$(cat "$rcf")
    rm -f "$rcf"
    if [ "$rc" -ne 0 ]; then
        printf 'Something went wrong. Run the command again with --verbose or see %s\n' "$LOG"
    fi
    return "$rc"
}
refresh() {
    sh "$BIN/fasdeqos-union" >>"$LOG" 2>&1 || true
}
after_native() {
    for p in "$@"; do
        name=$(bundle_name "$p")
        if [ -d "$APPS/$name.pkg" ]; then
            place_desktop "$APPS/$name.pkg"
        fi
    done
    for p in "$@"; do
        name=$(bundle_name "$p")
        if [ ! -d "$APPS/$name.pkg" ]; then
            continue
        fi
        if grep -qx "$p" "$LIBDIR/compat.list" 2>/dev/null; then
            sh "$BIN/fasdeqos-compat" "$name" >>"$LOG" 2>&1 || true
        fi
    done
    refresh
    for p in "$@"; do
        name=$(bundle_name "$p")
        if [ ! -d "$APPS/$name.pkg" ]; then
            continue
        fi
        if ! sh "$BIN/fasdeqos-libcheck" "$name" >>"$LOG" 2>&1; then
            printf 'Note: %s may need extra libraries. Details: %s\n' "$name" "$LOG"
        fi
    done
}
container_install() {
    p=$1
    name=$(bundle_name "$p")
    b=$APPS/$name.pkg
    c=fasdeqos-$p
    if [ -d "$b" ]; then
        printf '%s is already installed.\n' "$name"
        return 0
    fi
    printf '==> Installing %s in its own container (the first time takes a while)\n' "$name"
    hook="sed -i '/^#\[multilib\]/,/^#Include/ s/^#//' /etc/pacman.conf"
    snip=$(repo_snippet)
    if [ -n "$snip" ]; then
        hook="$hook; printf '%s\\n' '$snip' >> /etc/pacman.conf"
    fi
    hook="$hook; pacman -Sy"
    if ! as_user distrobox create --yes --name "$c" --image docker.io/library/archlinux:latest --pre-init-hooks "$hook" --additional-packages "base-devel git" >>"$LOG" 2>&1; then
        as_user distrobox rm --force "$c" >>"$LOG" 2>&1
        return 1
    fi
    tmp=$(mktemp -d /tmp/pkg-export.XXXXXX)
    chown "$user" "$tmp"
    cat > "$tmp/install.sh" <<'INSTALLER'
p=$1
if pacman -Si "$p" >/dev/null 2>&1; then
    sudo pacman -S --noconfirm --needed "$p" || exit 1
    exit 0
fi
if ! command -v yay >/dev/null 2>&1; then
    d=$(mktemp -d)
    git clone https://aur.archlinux.org/yay-bin.git "$d/yay-bin" || exit 1
    cd "$d/yay-bin" || exit 1
    makepkg -si --noconfirm || exit 1
fi
yay -S --noconfirm --needed "$p" || exit 1
exit 0
INSTALLER
    if ! as_user distrobox enter --name "$c" -- sh "$tmp/install.sh" "$p" >>"$LOG" 2>&1; then
        as_user distrobox rm --force "$c" >>"$LOG" 2>&1
        rm -rf "$tmp"
        return 1
    fi
    cat > "$tmp/export.sh" <<'EXPORT'
p=$1
out=$2
pacman -Qlq "$p" | while IFS= read -r f; do
    case $f in
        /usr/bin/?*)
            if [ -f "$f" ] || [ -L "$f" ]; then
                basename "$f" >> "$out/bin.list"
            fi ;;
        /usr/share/applications/*.desktop)
            cp "$f" "$out/" ;;
        /usr/share/icons/*|/usr/share/pixmaps/*)
            if [ -f "$f" ]; then
                mkdir -p "$out/files$(dirname "$f")"
                cp "$f" "$out/files$(dirname "$f")/"
            fi ;;
    esac
done
exit 0
EXPORT
    as_user distrobox enter --name "$c" -- sh "$tmp/export.sh" "$p" "$tmp" >>"$LOG" 2>&1
    mkdir -p "$b/usr/bin" "$b/usr/share/applications"
    if [ -f "$tmp/bin.list" ]; then
        while read -r bn; do
            if [ -e "/System/bin/$bn" ]; then
                continue
            fi
            printf '#!/usr/bin/env sh\nexec distrobox-enter --name %s -- /usr/bin/%s "$@"\n' "$c" "$bn" > "$b/usr/bin/$bn"
            chmod +x "$b/usr/bin/$bn"
        done < "$tmp/bin.list"
    fi
    for d in "$tmp"/*.desktop; do
        if [ ! -f "$d" ]; then
            continue
        fi
        sed -e '/^TryExec=/d' -e "s|^Exec=|Exec=distrobox-enter --name $c -- |" "$d" > "$b/usr/share/applications/$(basename "$d")"
    done
    place_desktop "$b"
    if [ -d "$tmp/files/usr" ]; then
        cp -a "$tmp/files/usr/." "$b/usr/"
    fi
    printf '%s\n' "$c" > "$b/container"
    chmod -R a+rX "$b"
    rm -rf "$tmp"
    mkdir -p "$RECEIPTS"
    printf 'bundle=%s\nrequested=%s\npackages=%s\nstate=installed\ncontainer=%s\n' "$name" "$p" "$p" "$c" > "$RECEIPTS/$name.receipt"
    printf '==> Installed %s\n' "$name"
    return 0
}
cmd=${1:-}
if [ $# -gt 0 ]; then
    shift
fi
case $cmd in
    union)
        refresh
        exit 0 ;;
    compat)
        for p in "$@"; do
            sh "$BIN/fasdeqos-compat" "$(bundle_name "$p")"
        done
        refresh
        exit 0 ;;
    check)
        for p in "$@"; do
            sh "$BIN/fasdeqos-libcheck" "$(bundle_name "$p")"
        done
        exit 0 ;;
    list-repo|list-repos)
        n=0
        for f in "$REPODIR"/*.repo; do
            if [ ! -f "$f" ]; then
                continue
            fi
            printf '%s  %s\n' "$(basename "$f" .repo)" "$(head -n1 "$f")"
            n=$((n + 1))
        done
        if [ "$n" -eq 0 ]; then
            printf 'No extra repositories. Add one with: pkg add-repo <url>\n'
        fi
        exit 0 ;;
    add-repo)
        url=${1:-}
        if ! valid_url "$url"; then
            printf 'Usage: pkg add-repo <http(s)://url> [name]\n'
            exit 1
        fi
        name=${2:-}
        if [ -z "$name" ]; then
            name=$(printf '%s' "$url" | sed -e 's|/*$||' -e 's|/os/.*$||' -e 's|/\$repo.*$||' -e 's|.*/||' -e 's|\.git$||' -e 's|[^A-Za-z0-9._-]|-|g')
        fi
        if ! valid_word "$name"; then
            printf 'Could not pick a name, pass one: pkg add-repo <url> <name>\n'
            exit 1
        fi
        mkdir -p "$REPODIR"
        printf '%s\n' "$url" > "$REPODIR/$name.repo"
        sync_repos
        printf 'Repository %s added.\n' "$name"
        exit 0 ;;
    remove-repo)
        name=${1:-}
        if ! valid_word "$name" || [ ! -f "$REPODIR/$name.repo" ]; then
            printf 'No such repository. See: pkg list-repo\n'
            exit 1
        fi
        rm -f "$REPODIR/$name.repo"
        sync_repos
        printf 'Repository %s removed.\n' "$name"
        exit 0 ;;
    install)
        : > "$LOG"
        sync_repos
        status=0
        native=""
        sysl=""
        for p in "$@"; do
            case $p in
                -*) continue ;;
            esac
            if is_system "$p"; then
                sysl="$sysl $p"
            elif containers_ok && is_heavy "$p"; then
                if ! container_install "$p"; then
                    printf 'The container install failed, installing %s the regular way.\n' "$p"
                    native="$native $p"
                fi
            else
                native="$native $p"
            fi
        done
        if [ -n "$sysl" ]; then
            printf '==> Installing system packages:%s\n' "$sysl"
            if run_sys -S --needed --noconfirm $sysl; then
                printf '==> Done. If you installed a kernel, it is ready for the next boot.\n'
            else
                status=1
            fi
        fi
        if [ -n "$native" ]; then
            run_real install $native || status=1
            after_native $native
        else
            refresh
        fi
        exit $status ;;
    sys)
        sys_writable || exit 1
        sys_pacman "$@"
        exit $? ;;
    kernel)
        sh "$BIN/fasdeqos-kernel" "$@"
        exit $? ;;
    uninstall|remove|rm)
        : > "$LOG"
        for p in "$@"; do
            case $p in
                -*) continue ;;
            esac
            name=$(bundle_name "$p")
            if [ -f "$APPS/$name.pkg/container" ] && [ -n "$user" ]; then
                as_user distrobox rm --force "$(cat "$APPS/$name.pkg/container")" >>"$LOG" 2>&1 || true
            fi
        done
        rc=0
        rest=""
        for p in "$@"; do
            case $p in
                -*) continue ;;
            esac
            name=$(bundle_name "$p")
            if is_system "$p" && [ ! -d "$APPS/$name.pkg" ]; then
                printf '==> Removing system package %s\n' "$p"
                run_sys -Rns --noconfirm "$p" || rc=1
            else
                rest="$rest $p"
            fi
        done
        if [ -n "$rest" ]; then
            run_real uninstall $rest || rc=1
        fi
        for p in "$@"; do
            name=$(bundle_name "$p")
            if [ -d "$APPS/$name.pkg" ] && [ -f "$APPS/$name.pkg/container" ]; then
                rm -rf "$APPS/$name.pkg"
            fi
            rm -f "$RECEIPTS/$name.receipt"
        done
        refresh
        exit $rc ;;
    upgrade)
        : > "$LOG"
        names=""
        if [ $# -gt 0 ]; then
            for p in "$@"; do
                names="$names $(bundle_name "$p")"
            done
        else
            printf '==> Updating the system\n'
            run_sys -Syu --noconfirm || true
            for r in "$RECEIPTS"/*.receipt; do
                if [ -f "$r" ]; then
                    names="$names $(basename "$r" .receipt)"
                fi
            done
        fi
        status=0
        for name in $names; do
            r=$RECEIPTS/$name.receipt
            if [ ! -f "$r" ]; then
                printf '%s is not installed.\n' "$name"
                continue
            fi
            c=$(field "$r" container)
            if [ -n "$c" ]; then
                printf '==> Upgrading %s\n' "$name"
                as_user distrobox upgrade --name "$c" >>"$LOG" 2>&1 || status=1
            else
                run_real upgrade "$(field "$r" requested)" || status=1
            fi
        done
        refresh
        exit $status ;;
    search)
        pacman -Ss "$@" 2>/dev/null
        exit 0 ;;
    info)
        pacman -Si "$@" 2>/dev/null || pacman -Qi "$@" 2>/dev/null
        exit 0 ;;
    list)
        for r in "$RECEIPTS"/*.receipt; do
            if [ -f "$r" ]; then
                basename "$r" .receipt
            fi
        done
        exit 0 ;;
    update|cleanup)
        run_real "$cmd" "$@"
        exit $? ;;
    *)
        raw_real "$cmd" "$@"
        exit $? ;;
esac
PKGW
}

tool_fish() {
    cat <<'FISHC'
function __pkg_installed
    for f in /Library/Receipts/*.receipt
        if test -f $f
            basename $f .receipt
        end
    end
end
function __pkg_repos
    for f in /Library/Repos/*.repo
        if test -f $f
            basename $f .repo
        end
    end
end
function __pkg_available
    pacman -Sl 2>/dev/null | string replace -r '^(\S+) (\S+).*' '$2\t$1'
end
set -l __pkg_cmds install uninstall remove rm upgrade update cleanup search list info list-repo add-repo remove-repo compat check union sys kernel
complete -c pkg -f
complete -c pkg -n "not __fish_seen_subcommand_from $__pkg_cmds" -a install -d "Install a package"
complete -c pkg -n "not __fish_seen_subcommand_from $__pkg_cmds" -a uninstall -d "Remove an installed package"
complete -c pkg -n "not __fish_seen_subcommand_from $__pkg_cmds" -a upgrade -d "Upgrade packages"
